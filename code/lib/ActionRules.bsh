importCommands("lib.misc");
importCommands("lib");
importCommands("lib.actions");
importCommands("lib.misc");
importCommands("lib.activity");

import bsh.This;
import android.graphics.Path;
import android.graphics.PathMeasure;
import android.recognized.GestureStroke;
import java.util.Collections;
import java.util.Comparator;
import bsh.BshMethod;

ActionRules(This config) {
	This TOP = this;
	This every = config.every;
	Map handleRules = config.rules;
	double minimumConfidence = config.handle.minConfidence;
	String MAIN_DIRECTORY = config.MAIN_DIRECTORY;
	String LOG_FILE = config.LOG_FILE;
	String handleName = config.handleName;

	retrieveAction(This recognized) {
		recognized.hasAction = false;
		recognized.index = (int) -1;
		recognized.every = TOP.every != null ? TOP.every : tasker.getJavaVariable("everyGesture");
		Map foreground;

		updateForeground() {
			if (foreground != null) return;
			foreground = getUsageEvents();
		}

		validateAction(Map action, This recognized) {
			boolean hasLength = action.containsKey("length");
			boolean hasPackages = action.containsKey("packages");
			boolean isMatch;

			if (hasLength) {
				double length = action.get("length");
				if (recognized.length < length) {
					isMatch = true;
				} else {
					return false;
				}
			} else {
				isMatch = true;
			}

			if (hasPackages && isMatch) {
				updateForeground();
				List packages = action.get("packages");
				for (String packageName: packages) {
					if (foreground.containsKey(packageName)) {
						isMatch = true;
						break;
					} else {
						return false;
					}
				}
			}

			return isMatch;
		}

		Map templateRules = handleRules.getOrDefault(recognized.name, new HashMap());

		String actionType = recognized.longPress ? "longPress" : "release";
		String patternName = recognized.name;
		double patternLength = recognized.length;
		double patternScore = recognized.score;

		Object actionRules = templateRules.getOrDefault(actionType, new ArrayList());
		double minConfidence = handleRules.getOrDefault("confidence", minimumConfidence);
		recognized.isTriggered = patternScore > minConfidence;
		recognized.confidence = minConfidence;

		// * Set default command
		String command = "Every=:=" + recognized.handleName + "=:=" + recognized.name + "=:=" + recognized.longPress;
		recognized.defaultCommand = command.toLowerCase();

		actionRules.sort(new Comparator() {
			compare(Object o1, Object o2) {
				// infinity default
				double length1 = ((Map) o1).getOrDefault("length", Double.POSITIVE_INFINITY);
				double length2 = ((Map) o2).getOrDefault("length", Double.POSITIVE_INFINITY);
				return Double.compare(length1, length2);
			}
		});

		int rulesCount = actionRules.size();
		log("Rules count: " + rulesCount + " list: \n" + tasker.toJson(actionRules, true));
		for (int i = 0; i < rulesCount; i++) {
			Map action = actionRules.get(i);
			boolean isMatch = validateAction(action, recognized);
			log("Action: " + action + " isMatch: " + isMatch);
			if (isMatch) {
				recognized.hasAction = true;
				recognized.action = action;
				break;
			}
		}

		return recognized;
	}

	public This Action(This rule) {
		This TOP = this;
		String command;
		List args = new ArrayList();
		boolean isLongPress;
		boolean hasInterval;
		long interval;
		Runnable task;

		if (!rule.hasAction) {
			command = "sendCommand";
			boolean longPress = rule.longPress;
			Map map = toMap(rule);
			String json = tasker.toJson(map, true);
			String commandText = rule.defaultCommand + "=:=" + json;
			args.add(commandText);
		} else {
			Map actionMap = rule.action;
			String name = rule.name;
			log("Running action" + rule.length);
			command = actionMap.get("command");
			isLongPress = rule.longPress;
			interval = actionMap.getOrDefault("interval", 0);
			hasInterval = interval > 0;
			args = (ArrayList) actionMap.getOrDefault("args", new ArrayList()).clone();
		}

		task = new Runnable() {
			run() {
				try {
					rule.index++;
					rule.invokeMethod(command, args.toArray());
				} catch (e) {
					log("Error: " + e.getMessage(), "ERROR");
					tasker.showToast("Error executing action for " + rule.name, "Error in " + rule.handleName + " handle");
					throw e;
				}
			}
		};

		run() {
			// Todo: Add separate object to handle helper mode e.g EveryActionHelper
			
			// Check if in helper mode
			if (every.inHelperMode) {
				boolean everyAction;

				// Check if every action
				if (rule.hasAction) {
					String command = rule.action.get("command");
					if (command.startsWith("every")) everyAction = true;
				}


				/* 
				 * Every action is exempted from helper mode
				 ! Otherwise it's not possible to toggling
				*/
				if (!everyAction) {
					every.helperModeManager.help(rule);
					return;
				}

			}

			if (rule.isTriggered) {
				if (hasInterval) return every.schedule(task, interval);
				else return every.execute(task);
			} else {
				return null;
			}
		}

		return this;
	}

	/*───────────────────────────────────────────────────────────────
	getAction(This recognized)
	**Get action with Recognized from Engine.bsh**
	───────────────────────────────────────────────────────────────*/
	getAction(This recognized) {
		This rule = retrieveAction(recognized);
		return Action(rule);
	}

	return this;
}
