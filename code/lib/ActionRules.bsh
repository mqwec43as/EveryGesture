importCommands("lib.misc");
importCommands("lib.activity");

import bsh.This;
import android.graphics.Path;
import android.graphics.PathMeasure;
import android.gesture.GestureStroke;
import java.util.Collections;
import java.util.Comparator;
import bsh.BshMethod;

ActionRules(This config) {
	This every = config.every;
	Map handleRules = config.rules;
	double minimumConfidence = config.handle.minConfidence;
	String MAIN_DIRECTORY = config.MAIN_DIRECTORY;
	String LOG_FILE = config.LOG_FILE;
	String handleName = config.handleName;
	Map lastGesture;
	Map entry;

	retrieveAction(This gesture) {
		gesture.hasAction = false;
		Map foreground;

		updateForeground() {
			if (foreground != null) return;
			foreground = getUsageEvents();
		}

		validateAction(Map action, This gesture) {
			boolean hasLength = action.containsKey("length");
			boolean hasPackages = action.containsKey("packages");
			boolean isMatch;

			if (hasLength) {
				double length = action.get("length");
				if (gesture.length < length) {
					isMatch = true;
				} else {
					return false;
				}
			} else {
				isMatch = true;
			}

			if (hasPackages && isMatch) {
				updateForeground();
				List packages = action.get("packages");
				for (String packageName: packages) {
					if (foreground.containsKey(packageName)) {
						isMatch = true;
						break;
					} else {
						return false;
					}
				}
			}

			return isMatch;
		}

		Map templateRules = handleRules.getOrDefault(gesture.name, new HashMap());

		String actionType = gesture.longPress ? "longPress" : "release";
		String patternName = gesture.name;
		double patternLength = gesture.length;
		double patternScore = gesture.score;

		Object actionRules = templateRules.getOrDefault(actionType, new ArrayList());
		double minConfidence = handleRules.getOrDefault("confidence", minimumConfidence);
		gesture.isTriggered = patternScore > minConfidence;
		gesture.confidence = minConfidence;

		Collections.sort((List) actionRules, new Comparator() {
			compare(Object o1, Object o2) {
				// infinity default
				double length1 = ((Map) o1).getOrDefault("length", Double.POSITIVE_INFINITY);
				double length2 = ((Map) o2).getOrDefault("length", Double.POSITIVE_INFINITY);
				return Double.compare(length1, length2);
			}
		});

		int rulesCount = actionRules.size();
		log("Rules count: " + rulesCount + " list: \n" + tasker.toJson(actionRules, true));
		for (int i = 0; i < rulesCount; i++) {
			Map action = actionRules.get(i);
			boolean isMatch = validateAction(action, gesture);
			log("Action: " + action + " isMatch: " + isMatch);
			if (isMatch) {
				gesture.hasAction = true;
				gesture.action = action;
				break;
			}
		}

		return gesture;
	}

	public This Action(This rule) {
		This TOP = this;
		String command;
		List args = new ArrayList();
		boolean isLongPress;
		boolean hasInterval;
		long interval;
		Runnable task;

		if (!rule.hasAction) {
			command = "sendCommand";
			boolean longPress = rule.longPress;
			String commandText = rule.handle + "=:=" + rule.name + "=:=" + longPress;
			args.add(commandText);
		} else {
			Map actionMap = rule.action;
			String name = rule.name;
			log("Running action" + rule.length);
			command = actionMap.get("command");
			isLongPress = rule.longPress;
			interval = actionMap.getOrDefault("interval", 0);
			hasInterval = interval > 0;
			args = (ArrayList) actionMap.getOrDefault("args", new ArrayList()).clone();
		}

		task = new Runnable() {
			run() {
				try {
					rule.invokeMethod(command, args.toArray());
				} catch (e) {
					log("Error: " + e.getMessage(), "ERROR");
				}
			}
		};

		run() {
			if (every.inHelperMode) {
				boolean everyAction;

				if (rule.hasAction) {
					String command = rule.action.get("command");
					if (command.startsWith("every")) everyAction = true;
				}

				if (!everyAction) {
					String title = rule.handle;
					String message = "Gesture: " + rule.name + "\nScore: " + rule.score + "\nLength: " + rule.length;
					tasker.showToast(message, title);
					return;
				}
			}

			if (rule.isTriggered) {
				if (hasInterval) return every.schedule(task, interval);
				else return every.execute(task);
			} else {
				return null;
			}
		}

		return this;
	}

	/*───────────────────────────────────────────────────────────────
	getAction(This recognized)
	**Get action with Recognized from Engine.bsh**
	───────────────────────────────────────────────────────────────*/
	getAction(This recognized) {
		This rule = retrieveAction(recognized);
		return Action(rule);
	}

	return this;
}
