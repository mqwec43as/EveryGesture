	/**
	 * getInstalledApps()
	 * Optimized: Only gathers Package Name and Resource ID to prevent Memory crashes.
	 */
	List getInstalledApps() {
		List items = new ArrayList();
		PackageManager pm = context.getPackageManager();

		List packages = pm.getInstalledPackages(0);

		packages.sort(new Comparator() {
			compare(Object o1, Object o2) {
				String label1 = ((PackageInfo) o1).applicationInfo.loadLabel(pm).toString();
				String label2 = ((PackageInfo) o2).applicationInfo.loadLabel(pm).toString();
				return label1.compareToIgnoreCase(label2);
			}
		});

		for (int i = 0; i < packages.size(); i++) {
			PackageInfo pkgInfo = (PackageInfo) packages.get(i);

			if (pkgInfo.applicationInfo == null) {
				continue;
			}

			Map itemMap = new HashMap();
			String label = pkgInfo.applicationInfo.loadLabel(pm).toString();
			itemMap.put("title", label);
			itemMap.put("subtitle", pkgInfo.packageName);
			itemMap.put("args", pkgInfo.packageName);
			itemMap.put("replacer", label);
			itemMap.put("iconResId", pkgInfo.applicationInfo.icon);
			itemMap.put("type", "app");

			items.add(itemMap);
		}
		return items;
	}

	import java.io.File;
	import com.joaomgcd.taskerm.action.java.JavaCodeException;

	getScriptList() {

		String scriptsDir = every.MAIN_DIRECTORY + "/scripts";
		File folder = new File(scriptsDir);
		List fileList = new ArrayList();

		if (!folder.exists() || !folder.isDirectory()) {
			return fileList;
		}

		File[] files = folder.listFiles();
		if (files == null) {
			return fileList;
		}

		for (i = 0; i < files.length; i++) {
			File f = files[i];
			if (f.isFile()) {
				Map file = new HashMap();
				file { "title" } = f.getName();
				file { "args" } = f.getName();
				file { "replacer" } = f.getName();
				fileList.add(file);
			}
		}

		return fileList;

	}

	String getProjectName(String taskName) {
		if (taskName == null) {
			return null;
		}

		Uri uri = Uri.parse("content://net.dinglisch.android.tasker/tasks");
		String[] projection = new String[] { "project_name" };
		String selection = "name = ?";
		String[] selectionArgs = new String[] { taskName };

		Cursor cursor = context.getContentResolver().query(uri, projection, selection, selectionArgs, null);
		if (cursor == null) {
			return null;
		}
		String projectName = null;
		try {
			if (cursor.moveToFirst()) {
				projectName = cursor.getString(0);
			}
		} finally {
			cursor.close();
		}

		return projectName;

	}

	/* toList
	 * Converts a 2D array to a List of Maps
	 * * Structure of each item:
	 * { "title": "Task Name", "subtitle": "Project Name" }
	 */
	List toList(String listName, Object[][] objects, String[] keys) {
		List list = new ArrayList();
		for (int i = 0; i < objects.length; i++) {
			Map entry = new HashMap();
			Object[] row = objects[i];
			
			/* Iterate through the keys to dictate the assignment */
			for (int j = 0; j < keys.length; j++) {
				String currentKey = keys[j];
				Object value = null;

				/* Assign value from row if index exists, otherwise remains null */
				if (row != null && j < row.length) {
					value = row[j];
				}

				entry.put(currentKey, value);
			}

			list.add(entry);

			/* Assign args to icon if args is null */
			String iconName = entry.containsKey("command") ? entry { "command" } : entry { "args" };
			entry.put("iconPath", every.MAIN_DIRECTORY + "/res/actions/" + listName + "/" + iconName + ".svg");
		}

		return list;
	}

	sort(List list, String key) {
		list.sort(new Comparator() {
			public int compare(Object o1, Object o2) {
				String key1 = ((Map) o1) { key };
				String key2 = ((Map) o2) { key };
				return key1.compareToIgnoreCase(key2);
			}
		});
	}

	final This TOP = this;
	List list = toList("command", mainActions, new String[] { "title", "subtitle", "command", "displayText" });
	sort(list, "title");
	
	Map actionMenu = new HashMap();
	Map newActionMenu = new HashMap();
	for (Map action: list) {
		String command = action { "command" };
		if (TOP.namespace.getVariable(command) != void) {
			List subAction = toList(command, TOP.namespace.getVariable(command), new String[] { "title", "subtitle", "args", "replacer" });
			sort(subAction, "title");
			actionMenu.put(command, subAction);
		}
	}

	getTasks() {
		actionMenu { "runTask" } = getTaskerTasks();
		newActionMenu { "taskName" } = actionMenu { "runTask" };
	}

	getApps() {
		actionMenu { "openApp" } = getInstalledApps();
		actionMenu { "showAppsTray" } = actionMenu { "openApp" };
		newActionMenu { "packageName" } = actionMenu { "openApp" };
		newActionMenu { "packageNames" } = actionMenu { "openApp" };
		newActionMenu { "labelOrPackageName" } = actionMenu { "openApp" };
	}

	getScripts() {
		actionMenu { "runScript" } = getScriptList();
		newActionMenu { "scriptPath" } = actionMenu { "runScript" };
	}

	getList(String command) {
		if (command == null) return new ArrayList();
		boolean hasKey = actionMenu.containsKey(command);

		if (command.equals("showAppsTray")) command = "openApp";

		if (hasKey) {
			return actionMenu { command };
		}

		switch (command) {
			case "runTask":
				getTasks();
				break;
			case "openApp":
			case "showAppsTray":
				getApps();
				break;
			case "runScript":
				getScripts();
				break;
		}
		
		hasKey = actionMenu.containsKey(command);
		if (hasKey) {
			return actionMenu { command };
		}

		return new ArrayList();
	}

	refresh(boolean withToast) {
		getTasks();
		getApps();
		getScripts();
		if (withToast) {
			showToast("Action List Refreshed");
		}
	}

	refresh() {
		refresh(false);
	}

	String getTitle(String command) {
		String description = "";
		for (Map action: TOP.list) {
			if (action { "command" }.equals(command)) {
				description = action { "title" };
				break;
			}
		}
		return description;
	}

	// * get text version of an action
	String getTextVersion(Map map) {
		String argText = "";
		if (map.containsKey("command")) {
			if (map.containsKey("title")) {
				argText = map { "title" };
			} else {
				argText = getTitle(map { "command" });
			}
		} else if (map.containsKey("args")) {
			argText = map { "title" };
		}
		return argText;
	}

	// * get text version of command
	String getCommandTextVersion(Map map) {
		String argText = "";
		if (map.containsKey("command")) {
			if (map.containsKey("title")) {
				argText = map { "title" };
			} else {
				argText = getTitle(map { "command" });
			}
		}
		return argText;
	}

	getLabel(String packageName) {
		String label = packageName;
		try {
			PackageManager pm = context.getPackageManager();
			PackageInfo pi = pm.getPackageInfo(packageName, 0);
			label = pi.applicationInfo.loadLabel(pm).toString();
		} catch (Exception e) {}
		return label;
	}

	/*
	 ! This should be depecrated to avoid confusion
	 Because config version it's not always from the selected map e.g args.
	 Say className which needs to be resolved with the selected packageName
	*/
	String getConfigVersion(Map map) {
		String argText = "";
		if (map.containsKey("command")) {
			argText = map { "command" };
		} else if (map.containsKey("args")) {
			argText = map { "args" };
		}
		return argText;
	}

	List getListConfigVersion(List mapList) {
		List argList = new ArrayList();
		for (Map map: mapList) {
			argList.add(getConfigVersion(map));
		}
		return argList;
	}

	// * Return the command map
	Map getCommandMap(String command) {
		for (Map action: TOP.list) {
			if (action { "command" }.equals(command)) {
				return action;
			}
		}
		return new HashMap();
	}

	// * Get the replacer for the target array, used as friendly value to be read
	String getReplacer(String command, String argTarget) {
		Map commandMap = getCommandMap(command);
		List list = getList(command);
		for (Map entry: list) {
			String args = entry { "args" };
			if (args.equals(argTarget)) {
				return entry { "replacer" };
			}
		}
		return null;
	}

	/*  
		* For displaying action as one string row, e.g for TemplateCard
		TODO might need to resolve all args and create based on command parameter
	*/
	String getDisplayText(Map actionMap, boolean useFullDisplay) {
		String command = actionMap { "command" };
		List args = actionMap { "args" };
		Map commandMap = getCommandMap(command);
		String placeHolderTemplate = commandMap { "displayText" };
		String placeHolder = "";
		if (actionMap.containsKey("length") && useFullDisplay) placeHolder += actionMap { "length" } + "px - ";
		placeHolder += placeHolderTemplate;
		if (args == null && placeHolder == null) return placeHolder;
		if (args.isEmpty()) return placeHolder;
		for (int i = 0; i < args.size(); i++) {
			Object entry = args.get(i);
			String replacer = "";
			switch (entry.getClass()) {
				case String.class:
					replacer = getReplacer(command, entry);
					if (command.equals("launchActivity")) replacer = getComponentName(entry);
					break;
				case List.class:
				case ArrayList.class:
					replacer = entry.size() + " items";
					break;
				case JSONArray.class:
					replacer = entry.length() + " items";
					break;
				default:
					log("Unknown type: " + entry.getClass(), TOP);
					replacer = entry.toString();
					break;
			}

			if (replacer == null) replacer = entry.toString();
			
			placeHolder = placeHolder.replace("{" + i + "}", replacer);
		}
		// clean leftover {\d+}
		placeHolder = placeHolder.replaceAll("\\{\\d+\\}", "");

		int maxLength = every.maxDisplayTextLength;
		if (placeHolder.length() > maxLength) {
			placeHolder = placeHolder.substring(0, maxLength) + "...";
		}
		return placeHolder;
	}

	getDisplayText(Map actionMap) {
		return getDisplayText(actionMap, true);
	}

	hasParameterList(String parameterName) {
		boolean hasKey = newActionMenu.containsKey(parameterName);
		return hasKey;
	}

	// * Get the parameter list
	getParameterList(String parameterName) {
		boolean hasKey = hasParameterList(parameterName);

		if (hasKey) {
			return newActionMenu { parameterName };
		}

		switch (parameterName) {
			case "taskName":
				getTasks();
				break;
			case "packageName":
			case "packageNames":
				getApps();
				break;
			case "scriptPath":
				getScripts();
				break;
			default:
				log("Unknown parameter: " + parameterName, TOP);
				try {
					if (TOP.namespace.getVariable(parameterName) == void) break;
					Object[][] objects = TOP.namespace.getVariable(parameterName);
					List subAction = toList(parameterName, objects, new String[] { "title", "subtitle", "args", "replacer" });
					sort(subAction, "title");
					if (!subAction.isEmpty()) newActionMenu.put(parameterName, subAction);
				} catch (Exception e) {
					log(e.getMessage(), "ERROR");
				}
				break;
		}

		hasKey = hasParameterList(parameterName);
		if (hasKey) {
			return newActionMenu { parameterName };
		}

		return new ArrayList();
	}

	
	import android.content.ComponentName;
	import android.content.pm.ActivityInfo;
	String getComponentName(String componentName) {
		ComponentName component = ComponentName.unflattenFromString(componentName);
		PackageManager pm = context.getPackageManager();
		ActivityInfo activityInfo = pm.getActivityInfo(component, PackageManager.GET_META_DATA);

		CharSequence label = activityInfo.loadLabel(pm);
		String labelStr = label.toString();
		String packageName = component.getPackageName();

		/* Get the main application label (e.g., "Tasker") */
		ApplicationInfo appInfo = pm.getApplicationInfo(packageName, 0);
		CharSequence appLabel = pm.getApplicationLabel(appInfo);
		String appLabelStr = appLabel != null ? appLabel.toString() : "";

		/* Check if the activity label matches the package string or the app name */
		if (labelStr.equalsIgnoreCase(packageName) || labelStr.equalsIgnoreCase(appLabelStr)) {
			String className = component.getClassName();
			int lastDot = className.lastIndexOf('.');
			String shortName = lastDot == -1 ? className : className.substring(lastDot + 1);

			/* Normalize camelCase shortName to spaced words (e.g., MainActivity -> Main Activity) */
			StringBuffer sb = new StringBuffer();
			for (int i = 0; i < shortName.length(); i++) {
				char c = shortName.charAt(i);
				if (i > 0 && Character.isUpperCase(c)) {
					sb.append(" ");
				}
				sb.append(c);
			}

			labelStr = labelStr + ", " + sb.toString();
		}

		return labelStr;

	}
	

	// * Get map argValue for args key in the parameter list
	Map getEntryMap(String parameter, Object argValue) {

		createMap(Object title, Object subtitle, Object args, Object replacer) {
			Map temp = new HashMap();
			temp.put("args", args);
			temp.put("replacer", replacer.toString());
			temp.put("title", title.toString());
			temp.put("subtitle", subtitle.toString());
			return temp;
		}

		switch (parameter) {
			case "packageName":
				String label = getLabel(argValue);
				if (label != null) return createMap(label, argValue, argValue, label);
				break;
			case "taskName":
				String projectName = getProjectName(argValue);
				if (projectName != null) return createMap(argValue, projectName, argValue, projectName);
				break;
			case "component":
				String componentName = getComponentName(argValue);
				if (componentName != null) return createMap(argValue, componentName, argValue, componentName);
				break;
		}

		List list = getParameterList(parameter);
		for (Map entry: list) {
			String args = entry { "args" };
			if (args.equals(argValue)) {
				return entry;
			}
		}
		
		Map temp = createMap(argValue, argValue, argValue, argValue);
		return temp;
	}

	List getEntryList(String parameter, List args) {
		List list = new ArrayList();
		for (String arg: args) {
			Map entry = getEntryMap(parameter, arg);
			list.add(entry);
		}
		return list;
	}

	String getParameterText(String parameter, Object argValue) {
		Map entry = getEntryMap(parameter, argValue);
		String title = entry { "title" };
		return title;
	}

	String getParameterText(String parameter, List args) {
		if (parameter.endsWith("s")) {
			parameter = parameter.substring(0, parameter.length() - 1);
		}
		JSONArray jsonArray = new JSONArray();
		for (Object arg: args) {
			String title = getParameterText(parameter, arg);
			jsonArray.put(title);
		}
		return jsonArray.toString(1);
	}

	String getParameterTextFromMap(Map map) {
		Object argText = map.get("args");
		if (argText instanceof List) {
			argText = argText.toString();
		} else if (!(argText instanceof String)) {
			argText = argText.toString();
		}
		if (map.containsKey("args")) {
			argText = map { "title" };
		}
		return argText;
	}

	String getParameterTextFromList(List mapList) {
		JSONArray jsonArray = new JSONArray();
		for (Map map: mapList) {
			jsonArray.put(getParameterTextFromMap(map));
		}
		String argText = jsonArray.toString(1);
		return argText;
	}

	return this;
}



