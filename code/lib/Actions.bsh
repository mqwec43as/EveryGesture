	import android.database.Cursor;
	import android.net.Uri;
	import java.util.ArrayList;
	import java.util.HashMap;
	import java.util.Map;

	/**
	 * getTaskerTasks()
	 * * Queries the Tasker Content Provider for named tasks.
	 * Returns an ArrayList of HashMaps compatible with AdvancedListDialog.
	 * * Structure of each item:
	 * { "title": "Task Name", "subtitle": "Project Name" }
	 */
	getTaskerTasks() {
		ArrayList items = new ArrayList();

		// URI for Tasker Tasks
		Uri uri = Uri.parse("content://net.dinglisch.android.tasker/tasks");

		// Querying: name, project_name. 
		// Sorting: "name ASC" for alphabetical order.
		Cursor c = context.getContentResolver().query(uri, null, null, null, "name ASC");
		if (c != null) {
			int nameCol = c.getColumnIndex("name");
			int projNameCol = c.getColumnIndex("project_name");
			while (c.moveToNext()) {
				String taskName = c.getString(nameCol);
				String projectName = c.getString(projNameCol);

				// Construct the map for the advanced list
				Map itemMap = new HashMap();
				itemMap.put("title", taskName);
				itemMap.put("subtitle", projectName);
				itemMap.put("args", taskName);
				itemMap.put("replacer", taskName);

				items.add(itemMap);
			}
			c.close();
		}
		return items;
	}



	import android.content.Intent;
