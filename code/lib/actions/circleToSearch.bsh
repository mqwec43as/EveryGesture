// https://github.com/parallelcc/MiCTS/blob/2ead158104bdb8605cbb5eae39a30d44db71bab6/app/src/main/java/com/parallelc/micts/ui/activity/MainActivity.kt#L34

import android.content.Context;
import android.os.Bundle;
import android.os.IBinder;
import android.os.SystemClock;
import android.os.Build;
import android.os.ServiceManager;
import com.android.internal.app.IVoiceInteractionManagerService;
import com.android.internal.app.*;
import android.service.voice.VoiceInteractionSession;
import com.joaomgcd.taskerm.action.java.JavaCodeException;


/*───────────────────────────────────────────────────────────────
  circleToSearch()
  **Triggers Android's Circle to Search (Omni)**
  Uses privileged internal APIs to invoke the Voice Interaction 
  Manager Service (VIMS) via Shizuku. 
 
  Returns:
   - boolean → True if the session was successfully shown, false otherwise.
  ───────────────────────────────────────────────────────────────*/
circleToSearch() {
	/*	
	https://cs.android.com/android/platform/superproject/+/android-latest-release:frameworks/base/core/java/android/service/voice/VoiceInteractionSession.java?q=showSessionFromSession&ss=android%2Fplatform%2Fsuperproject
		Voice Interaction Service Flags:
		- SHOW_WITH_ASSIST = 1 << 0: Request session start with assist data.
		- SHOW_WITH_SCREENSHOT = 1 << 1: Request session start with screenshot.
		- SHOW_SOURCE_ASSIST_GESTURE = 1 << 2: Session started from assist gesture.
		- SHOW_SOURCE_APPLICATION = 1 << 3: App itself invoked assistant.
		- SHOW_SOURCE_ACTIVITY = 1 << 4: Activity invoked local voice interaction.
		- SHOW_SOURCE_PUSH_TO_TALK = 1 << 5: Invoked from physical button.
		- SHOW_SOURCE_NOTIFICATION = 1 << 6: Invoked from notification.
		- SHOW_SOURCE_AUTOMOTIVE_SYSTEM_UI = 1 << 7: Invoked from automotive UI.
		- SHOW_WITH_ASSIST_STRUCTURE_SCREEN_CONTENT = 1 << 8: Include screen content in AssistStructure.
	*/
	boolean success = false;
	int entryPoint = 1;
	int flags = VoiceInteractionSession.SHOW_SOURCE_ASSIST_GESTURE | VoiceInteractionSession.SHOW_WITH_SCREENSHOT | VoiceInteractionSession.SHOW_WITH_ASSIST;
	
	try {
		/* Prepare invocation bundle with required metadata */
		Bundle bundle = new Bundle();
		bundle.putLong("invocation_time_ms", SystemClock.elapsedRealtime());
		bundle.putInt("omni.entry_point", entryPoint);
		bundle.putBoolean("micts_trigger", true);

		IBinder binder = ServiceManager.getService(Context.VOICE_INTERACTION_MANAGER_SERVICE);
		IVoiceInteractionManagerService vims = IVoiceInteractionManagerService.Stub.asInterface(binder);
		/* Handle API differences based on Android version */
	
		if (Build.VERSION.SDK_INT >= 34) {
			success = (Boolean) vims.showSessionFromSession(binder, bundle, flags, context.getAttributionTag());
		} else {
			success = (Boolean) vims.showSessionFromSession(binder, bundle, flags);
		}
	} catch (Exception e) {
		log(e.getMessage(), "ERROR");
		throw new JavaCodeException(e.getMessage());
		return false;
	}

	return success;
}