importCommands("lib.ui");

everyAction(String everyCommand) {
	This every = tasker.getJavaVariable("everyGesture");
	switch (everyCommand) {
		case "helper":
			every.inHelperMode = !every.inHelperMode;
			String name = "the same gesture";
			if (rule != void) name = rule.name;
			String message = "Perform " + name + " again to toggle the mode";
			if (every.inHelperMode) {
				tasker.showToast("Handle won't trigger anymore" + "\n\n" + message, "Gesture helper start");
			} else {
				tasker.showToast("Gesture helper is turned off");
			}
			break;
		case "activity":
			Main();
			break;
	}
}