importCommands("lib.misc");
importCommands("lib.shizuku");

import android.app.ActivityManager;
import android.app.IActivityManager;
import android.os.IBinder;
import android.app.ActivityManager.RecentTaskInfo;
import android.content.Context;

openRecentApp(int lastAppIndex) {
	IActivityManager am = every.shizukuManager.getService(Context.ACTIVITY_SERVICE);
	List recents = am.getRecentTasks(lastAppIndex + 1, ActivityManager.RECENT_IGNORE_UNAVAILABLE, 0).getList();
	if (!recents.isEmpty()) {
		RecentTaskInfo task = recents.getLast();
		am.moveTaskToFront(null, "com.android.shell", task.taskId, 0, null);
		return task;
	}
	return null;
}