importCommands("lib.misc");
importCommands("lib");
import bsh.This;
import bsh.NameSpace;
import android.view.accessibility.AccessibilityNodeInfo;
import java.util.regex.Pattern;
import java.util.regex.Matcher;

screenInfo() {
	setNameSpace(this.caller.namespace);
	This TOP = this;

	getRoot() {
		return tasker.getAccessibilityService().getRootInActiveWindow();
	}

	Map recent = getUsageEvents();
	String command = handleName + "=:=" + name + "=:=" + longPress;
	String packageName = recent { "packageName" };
	This reader = every.uiReader;
	String className = recent { "className" };
	String appName = every.packageManager.getLabel(packageName);
	This helper = handle.config.helper;
	String text;
	This read;
	set() {
		NameSpace callerSpace = this.caller.namespace;
		helper.toNameSpace(callerSpace, TOP.namespace, true);
	}

	isPackageMatch(String targetPackage) {
		Pattern pattern = Pattern.compile(targetPackage);
		Matcher matcher = pattern.matcher(packageName);
		return matcher.matches();
	}

	read() {
		if (read == null) read = reader.read();
		NameSpace callerSpace = this.caller.namespace;
		helper.toNameSpace(callerSpace, read.namespace, true);
	}

	readByText(String text) {
		if (read == null) read = reader.readByText(text, reader.FLAG_SKIP_NO_TEXT);
		NameSpace callerSpace = this.caller.namespace;
		helper.toNameSpace(callerSpace, read.namespace, true);
	}

	readById(String id) {
		if (read == null) read = reader.readById(id, reader.FLAG_SKIP_NO_TEXT);
		NameSpace callerSpace = this.caller.namespace;
		helper.toNameSpace(callerSpace, read.namespace, true);
	}

	setVar(String name, String value) {
		String prefixHandle = "EG_";
		tasker.setVariable(prefixHandle + name, value);
	}

	fireDefault() {
		if (read == null) read();
		setVar("AppActivity", className);
		setVar("Text", read.text);
		setVar("TextResource", read.defaultText);
		setVar("AppPackage", packageName);
		setVar("AppName", appName);
		String newCom = command + "=:=" +  tasker.toJson(action, true);
		tasker.sendCommand(newCom);
	}

	runEvents(This event) {
		Runnable runnable = new Runnable() {
			run() {
				try {
					if (longPress) {
						event.onLongPress(TOP);
					} else {
						event.onRelease(TOP);
					}
				} catch (e) {
					tasker.showToast(e.getMessage());
				}
			}
		};
		every.executor.execute(runnable);
	}

	List events = new ArrayList(every.screenInfoEvents.values());
	if (events.isEmpty()) {
		fireDefault();
		return;
	}

	boolean hasFired;
	for (This event: events) {
		boolean isFiring = true;
		if (event.packageName != void) {
			isFiring = isPackageMatch(event.packageName);
		}
		if (isFiring) {
			if (!hasFired) hasFired = true;
			runEvents(event);
		}
	}
	
	if (!hasFired) fireDefault();
}