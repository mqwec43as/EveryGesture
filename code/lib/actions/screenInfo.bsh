importCommands("lib.misc");
importCommands("lib");

import bsh.This;
import bsh.NameSpace;
import android.view.accessibility.AccessibilityNodeInfo;
import java.util.regex.Pattern;
import java.util.regex.Matcher;

screenInfo() {

	setNameSpace(this.caller.namespace);
	This TOP = this;

	NameType() {
		final String PREFIX = "EG_";
		final String APP_ACTIVITY = "AppActivity";
		final String TEXT = "Text";
		final String TEXT_RESOURCE = "TextResource";
		final String APP_PACKAGE = "AppPackage";
		final String APP_NAME = "AppName";
		final String EVENT_BRIDGE = "EventBridge";
		return this;
	}

	final This NameType = NameType();

	getRoot() {
		return tasker.getAccessibilityService().getRootInActiveWindow();
	}

	Map recent = getUsageEvents();
	String packageName = recent { "packageName" };
	This reader = every.uiReader;
	String className = recent { "className" };
	String appName = every.packageManager.getLabel(packageName);
	This helper = handle.config.helper;
	String text;
	This read;

	setVar(String name, String value) {
		tasker.setVariable(NameType.PREFIX + name, value, true);
	}

	setVar(NameType.APP_ACTIVITY, null);
	setVar(NameType.APP_PACKAGE, null);
	setVar(NameType.APP_NAME, null);
	setVar(NameType.TEXT, null);
	setVar(NameType.TEXT_RESOURCE, null);

	set() {
		NameSpace callerSpace = this.caller.namespace;
		helper.toNameSpace(callerSpace, TOP.namespace, true);
	}

	isPackageMatch(String targetPackage) {
		Pattern pattern = Pattern.compile(targetPackage);
		Matcher matcher = pattern.matcher(packageName);
		return matcher.matches();
	}

	read() {
		if (read == null) read = reader.read();
		NameSpace callerSpace = this.caller.namespace;
		helper.toNameSpace(callerSpace, read.namespace, true);
	}

	readByText(String text) {
		if (read == null) read = reader.readByText(text, reader.FLAG_SKIP_NO_TEXT);
		NameSpace callerSpace = this.caller.namespace;
		helper.toNameSpace(callerSpace, read.namespace, true);
	}

	readById(String id) {
		if (read == null) read = reader.readById(id, reader.FLAG_SKIP_NO_TEXT);
		NameSpace callerSpace = this.caller.namespace;
		helper.toNameSpace(callerSpace, read.namespace, true);
	}

	fireCommand(String command) {
		int eventMethod = every.EventMethod != void ? every.EventMethod : every.EventType.COMMAND;
		switch (eventMethod) {
			case every.EventType.COMMAND:
				tasker.sendCommand(command);
				break;
			case every.EventType.EVENT_BRIDGE:
				setVar(NameType.EVENT_BRIDGE, command);
				break;
			default:
				// ! Bridge Event because there is command event fired quicker than variable set event
				setVar(NameType.EVENT_BRIDGE, command);
				break;
		};
	}

	fireDefault() {
		if (read == null) read();
		helper.toNameSpace(TOP.namespace, read.namespace, true);
		setVar(NameType.APP_ACTIVITY, className);
		setVar(NameType.TEXT, read.text);
		setVar(NameType.TEXT_RESOURCE, read.defaultText);
		setVar(NameType.APP_PACKAGE, packageName);
		setVar(NameType.APP_NAME, appName);

		Map map = toMap(TOP);
		String json = tasker.toJson(map, true);
		String newCom = defaultCommand + "=:=" + json;

		long eventDelay = every.EventDelay != void ? every.EventDelay : 0;
		Runnable runnable = new Runnable() {
			run() {
				fireCommand(newCom);
			}
		};

		if (eventDelay > 0) {
			every.schedule(runnable, eventDelay);
		} else {
			every.execute(runnable);
		}
	}

	runEvents(This event) {
		Runnable runnable = new Runnable() {
			run() {
				try {
					if (longPress) {
						event.onLongPress(TOP);
					} else {
						event.onRelease(TOP);
					}
				} catch (e) {
					tasker.showToast(e.getMessage());
				}
			}
		};
		every.executor.execute(runnable);
	}

	List events = new ArrayList(every.screenInfoEvents.values());
	if (events.isEmpty()) {
		fireDefault();
		return;
	}

	boolean hasFired;
	for (This event: events) {
		boolean isFiring = true;
		if (event.packageName != void) {
			isFiring = isPackageMatch(event.packageName);
		}
		if (isFiring) {
			if (!hasFired) hasFired = true;
			runEvents(event);
		}
	}

	if (!hasFired) fireDefault();
}