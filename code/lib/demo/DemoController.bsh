DemoController(This handle) {
	This listener;
	This tm = ThemeManager(context);
	boolean isShownAlready = handle.isShown();
	boolean isAddedAlready = handle.isAdded();
	WindowManager.LayoutParams initialParams;
	if (isShownAlready) {
		initialParams = new WindowManager.LayoutParams();
		initialParams.copyFrom(handle.params);
	}

	int highlightColor = tm.setAlpha(Color.CYAN, 190);


	highlight() {
		listener() {
			onAttached() {
				handle.setColorForAwhile(1500, highlightColor);
				handle.setInteractable(false);
				handle.setStateListener(null);
			}

			onDetached() {}
			return this;
		}
		if (!isShownAlready) {
			handle.setStateListener(listener());
			handle.show();
		} else {
			handle.setInteractable(false);
			handle.setColorForAwhile(1500, highlightColor);
		}
	}

	move(Point point) {
		handle.moveTo(point);
	}

	resize(Point size) {
		handle.sizeTo(size.x, size.y);
	}

	color(int color) {
		handle.setColor(color);
	}

	reset() {
		try {
			handle.setColor(handle.config.handle.color);
			handle.WINDOW_MANAGER.updateViewLayout(handle.view, initialParams);
			handle.setInteractable(true);
		} catch (e) {
			log("Error: " + e.getMessage(), "ERROR");
		}
	}

	remove() {
		reset();
		if (!isAddedAlready) handle.remove();
		if (listener != null) listener.onRemove();
	}

	setListener(This newListener) {
		listener = newListener;
	}

	return this;



}