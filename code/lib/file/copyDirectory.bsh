import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.util.ArrayList;
import java.util.List;

/**
 * Copies all contents from sourceDir to destDir using iterative logic.
 * Returns a List of File objects representing all successfully copied files.
 */
copyDirectory(File sourceDir, File destDir) {
	List copiedFiles = new ArrayList();

	if (sourceDir == null || !sourceDir.exists() || !sourceDir.isDirectory()) {
		return copiedFiles;
	}

	if (!destDir.exists()) {
		destDir.mkdirs();
	}

	/* Use parallel lists to track directories to process (simulating a stack) */
	List srcList = new ArrayList();
	List destList = new ArrayList();

	srcList.add(sourceDir);
	destList.add(destDir);

	/* Traditional for-loop for BeanShell compatibility */
	for (int i = 0; i < srcList.size(); i++) {
		File currentSrc = (File) srcList.get(i);
		File currentDest = (File) destList.get(i);

		if (!currentDest.exists()) {
			currentDest.mkdirs();
		}

		File[] files = currentSrc.listFiles();
		if (files == null) continue;

		for (int j = 0; j < files.length; j++) {
			File file = files[j];
			File targetFile = new File(currentDest, file.getName());

			if (file.isDirectory()) {
				/* Add subdirectory to the queue */
				srcList.add(file);
				destList.add(targetFile);
			} else {
				/* Standard java.io File Copy */
				FileInputStream fis = null;
				FileOutputStream fos = null;
				try {
					fis = new FileInputStream(file);
					fos = new FileOutputStream(targetFile);
					byte[] buffer = new byte[8192];
					int length;
					while ((length = fis.read(buffer)) > 0) {
						fos.write(buffer, 0, length);
					}
					/* Add to result list after successful copy */
					copiedFiles.add(targetFile);
				} finally {
					if (fis != null) fis.close();
					if (fos != null) fos.close();
				}
			}
		}
	}
	return copiedFiles;
}

copyDirectory(String sourceString, String destString) {
	File source = new File(sourceString);
	File dest = new File(destString);
	return copyDirectory(source, dest);
}