import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;

/**
 * Copies a single file from source to destination using standard streams.
 * Optimized for BeanShell (JDK 1.4 syntax).
 */
boolean copyFile(File sourceFile, File destFile) {
	if (sourceFile == null || !sourceFile.exists()) {
		return false;
	}

	FileInputStream fis = null;
	FileOutputStream fos = null;
	try {
		fis = new FileInputStream(sourceFile);
		fos = new FileOutputStream(destFile);

		/* 8KB buffer for balanced performance and memory usage */
		byte[] buffer = new byte[8192];
		int length;

		while ((length = fis.read(buffer)) > 0) {
			fos.write(buffer, 0, length);
		}
		return true;
	} catch (Exception e) {
		/* Tasker compatible logging if needed */
		return false;
	} finally {
		/* Manual resource cleanup is required in BeanShell */
		if (fis != null) {
			try { fis.close(); } catch (Exception e) {}
		}
		if (fos != null) {
			try { fos.close(); } catch (Exception e) {}
		}
	}
}

copyFile(String soureString, String destString) {
	File source = new File(sourceString);
	File dest = new File(destString);
	return copyFile(source, dest);
}