import bsh.This;
import org.json.JSONArray;
import java.util.Iterator;
import java.util.ArrayList;
import java.util.Map;
import bsh.This;
import android.graphics.Color;
import android.graphics.PointF;
import android.graphics.Point;
import bsh.Variable;
import bsh.NameSpace;
import android.content.ComponentName;
import java.util.Comparator;
import java.util.Collections;

This ConfigHelper() {

	config(String name) {
		this.namespace.setName(name);
		Map MAP = new HashMap();
		List KEYS = new ArrayList();

		getValue(String key) {
			return this.namespace.getVariable(key);
		}

		getDefaultValue(String key) {
			if (this.name.equals("Handle")) {
				return Handle.namespace.getVariable(key);
			} else if (this.name.equals("LivePath")) {
				return LivePath.namespace.getVariable(key);
			} else return null;
		}

		getKeys() {
			KEYS.sort(new Comparator() {
				compare(Object o1, Object o2) {
					This t1 = (This) o1;
					This t2 = (This) o2;

					boolean isBool1 = (t1.type == Boolean.class);
					boolean isBool2 = (t2.type == Boolean.class);

					// Prioritize Boolean.class (true goes first)
					if (isBool1 != isBool2) {
						return isBool1 ? -1 : 1;
					}

					// Fallback to alphabetical sorting if types have the same priority
					String key1 = t1.displayName;
					String key2 = t2.displayName;
					return key1.compareTo(key2);
				}
			});
			return KEYS;
		}

		return this;
	}
	This Handle = config("Handle");
	This LivePath = config("LivePath");
	Map map = new HashMap();

	// * key, type, inputType, defaultValue, defaultInput, displayName, description
	Object[][] handleKeys = new Object[][] {
