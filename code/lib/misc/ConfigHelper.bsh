	loadConfiguration(Object[][] configKeys, This target) {
		This KeyConfiguration(Object[] config) {
			String key = config[0];
			Class type = config[1];
			Class inputType = config[2];
			Object defaultValue = config[3];
			Object defaultInput = config[4];
			String displayName = config[5];
			String description = config[6];
			return this;
		}
		for (Object[] key: configKeys) {
			This config = KeyConfiguration(key);
			target.KEYS.add(config);
			target.MAP.put(config.key, config);
			map.put(config.key, config.inputType);
			target.namespace.setTypedVariable(config.key, config.type, config.defaultValue, true);
		}
	}

	loadConfiguration(handleKeys, Handle);
	loadConfiguration(livePathKeys, LivePath);

	getInputType(String key) {
		return map.get(key);
	}

	toJsonPointF(PointF point) {
		JSONArray list = new JSONArray();
		list.put(point.x);
		list.put(point.y);
		return list;
	}

	toJsonPoint(Point point) {
		JSONArray list = new JSONArray();
		list.put(point.x);
		list.put(point.y);
		return list;
	}

	toJsonColor(int color) {
		return String.format("#%08X", new Object[] {
			color
		});
	}

	toJsonList(List list) {
		JSONArray array = new JSONArray();
		for (int i = 0; i < list.size(); i++) {
			array.put(list.get(i));
		}
		return array;
	}

	toJson(String string) {
		return string;
	}

	toJsonDouble(double number) {
		Float value = Float.valueOf(number.toString());
		return value;
	}

	toJsonFloat(float number) {
		return number;
	}

	toJsonInteger(int number) {
		return number;
	}

	toJsonColor(int color) {
		return String.format("#%08X", new Object[] {
			color
		});
	}

	isKeyNameValid(String key) {
		return map.containsKey(key);
	}

	toJson(JSONObject json, NameSpace space) {
		String[] varNames = space.getVariableNames();
		for (String name: varNames) {
			if (!isKeyNameValid(name)) continue;
			Object value = space.getVariable(name);
			Class type = getInputType(name);
			Object newVarValue;
			if (type != null) {
				switch (type) {
					case PointF.class:
						newVarValue = toJsonPointF((PointF) value);
						break;
					case Point.class:
						newVarValue = toJsonPoint((Point) value);
						break;
					case Color.class:
						newVarValue = toJsonColor((int) value);
						break;
					case List.class:
						newVarValue = toJsonList((List) value);
						break;
					default:
						break;
				}
			}
			if (newVarValue != null) {
				json.put(name, newVarValue);
			} else {
				json.put(name, value);
			}
		}
		return json;
	}

	toPointF(JSONArray array) {
		PointF point = new PointF();
		point.x = (float) array.get(0);
		point.y = (float) array.get(1);
		return point;
	}

	toPoint(JSONArray array) {
		Point point = new Point();
		point.x = (int) array.get(0);
		point.y = (int) array.get(1);
		return point;
	}

	toColor(String string) {
		return Color.parseColor(string);
	}

	toFloat(double number) {
		Float value = Float.valueOf(number.toString());
		return value;
	}

	toList(JSONArray array) {
		ArrayList list = new ArrayList();
		for (int i = 0; i < array.length(); i++) {
			list.add(array.get(i));
		}
		return list;
	}

	getVariableList(NameSpace space) {
		String[] varNames = space.getVariableNames();
		return Arrays.asList(varNames);
	}

	// * Set variables from a JSON object to NameSpace
	toNameSpace(NameSpace space, JSONObject json, boolean setAll) {
		Iterator keys = json.keys();
		List varList = getVariableList(space);
		while (keys.hasNext()) {
			String varName = (String) keys.next();
			if (!isKeyNameValid(varName) && !setAll) continue;
			boolean hasVar = varList.contains(varName);
			Object varValue = json.get(varName);
			Class varType = getInputType(varName);
			Object newVarValue;
			if (Class != null) {
				switch (varType) {
					case PointF.class:
						newVarValue = toPointF(varValue);
						break;
					case Point.class:
						newVarValue = toPoint(varValue);
						break;
					case Color.class:
						newVarValue = toColor(varValue);
						break;
					case Float.class:
						newVarValue = toFloat(varValue);
						break;
					case List.class:
						newVarValue = toList(varValue);
						break;
					case Double.class:
						newVarValue = (double) varValue;
					default:
						break;
				}
			}

			if (newVarValue != null) {
				space.unsetVariable(varName);
				space.setVariable(varName, newVarValue, false);
			} else {
				space.setVariable(varName, varValue, false);
			}

		}
	}

	toNameSpace(NameSpace space, JSONObject json) {
		toNameSpace(space, json, false);
	}

	// * Set variables from NameSpace to NameSpace
	toNameSpace(NameSpace targetSpace, NameSpace sourceSpace, boolean setAll) {
		String[] varNames = sourceSpace.getVariableNames();
		for (String name: varNames) {
			if (!isKeyNameValid(name) && !setAll) continue;
			Object value = sourceSpace.getVariable(name);
			if (value != null) targetSpace.setVariable(name, value, false);
		}
	}

	toNameSpace(NameSpace targetSpace, NameSpace sourceSpace) {
		toNameSpace(targetSpace, sourceSpace, false);
	}

	getHandleDefaultValue(String key) {
		return Handle.namespace.getVariable(key);
	}

	getLivePathDefaultValue(String key) {
		return LivePath.namespace.getVariable(key);
	}

	return this;
}