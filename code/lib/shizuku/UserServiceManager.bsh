import android.app.IActivityManager;
import android.app.IActivityTaskManager;
import android.net.wifi.IWifiManager;
import android.net.ITetheringConnector;
import android.os.IBinder;
import android.content.Context;
import com.joaomgcd.taskerm.action.java.JavaCodeException;

UserServiceManager() {
	boolean hasIActivityManager;
	boolean hasIActivityTaskManager;
	boolean hasITetheringConnector;
	boolean hasIWifiManager;

	String hasIActivityManagerError;
	String hasIActivityTaskManagerError;
	String hasIWifiManagerError;
	String hasITetheringConnectorError;

	IBinder iActivityBinder, iActivityTaskBinder, tetherBinder, wifiBinder;
	IActivityManager iActivityManager;
	IActivityTaskManager iActivityTaskManager;
	ITetheringConnector iTetheringConnector;
	IWifiManager iWifiManager;

	String getErrorMessage(Class clazz) {
		String text = "";
		switch (clazz) {
			case IActivityManager.class:
				text = hasIActivityManagerError;
			case IActivityTaskManager.class:
				text = hasIActivityTaskManagerError;
			case IWifiManager.class:
				text = hasIWifiManagerError;
			case ITetheringConnector.class:
				text = hasITetheringConnectorError;
		}
		String defaultErrorMessage = "Can't access " + text + " method due to hidden api restriction";
		return defaultErrorMessage;
	}

    void checkIActivityManager() {
        hasIActivityManager = false;
        IActivityManager.Stub.class.getMethod("asInterface", new Class[] { IBinder.class });
		hasIActivityManager = true;
    }

    void checkIActivityTaskManager() {
        hasIActivityTaskManager = false;
        IActivityTaskManager.Stub.class.getMethod("asInterface", new Class[] { IBinder.class });
        hasIActivityTaskManager = true;
    }

	void checkIWifiManager() {
		hasIActivityManager = false;
		IWifiManager.Stub.class.getMethod("asInterface", new Class[] { IBinder.class });
		hasIActivityManager = true;
	}

	void checkITetheringConnector() {
		hasITetheringConnector = false;
		ITetheringConnector.Stub.class.getMethod("asInterface", new Class[] { IBinder.class });
		hasITetheringConnector = true;
	}

	boolean hasIActivityManager(boolean throwError) {
		try {
			checkIActivityManager();
		} catch (e) {
			hasIActivityManagerError = e.getMessage();
			if (throwError) {
				checkIActivityManager();
			}
		}
		return hasIActivityManager;
	}

	boolean hasIActivityManager() {
		return hasIActivityManager(false);
	}

	boolean hasIActivityTaskManager(boolean throwError) {
		try {
            checkIActivityTaskManager();
		} catch (e) {
			hasIActivityTaskManagerError = e.getMessage();
			if (throwError) {
                checkIActivityTaskManager();
			}
		}
		return hasIActivityTaskManager;
	}

	boolean hasIActivityTaskManager() {
		return hasIActivityTaskManager(false);
	}

	boolean hasITetheringConnector(boolean throwError) {
		try {
			checkITetheringConnector();
		} catch (e) {
			hasITetheringConnectorError = e.getMessage();
			if (throwError) {
				checkITetheringConnector();
			}
		}
		return hasITetheringConnector;
	}

	boolean hasITetheringConnector() {
		return hasITetheringConnector(false);
	}

	boolean hasIWifiManager(boolean throwError) {
		try {
			checkIWifiManager();
		} catch (e) {
			hasIWifiManagerError = e.getMessage();
			if (throwError) {
				checkIWifiManager();
			}
		}
		return hasIWifiManager;
	}

	boolean hasIWifiManager() {
		return hasIWifiManager(false);
	}

	IActivityManager getIActivityManager(boolean refresh) {
		if (iActivityBinder == null || refresh || (iActivityManager != null && !iActivityBinder.isBinderAlive())) {
			iActivityBinder = tasker.getShizukuService(Context.ACTIVITY_SERVICE);
			iActivityManager = IActivityManager.Stub.asInterface(iActivityBinder);
		} 
		return iActivityManager;
	}

	IActivityManager getIActivityManager() {
		return getIActivityManager(false);
	}

	IActivityTaskManager getIActivityTaskManager(boolean refresh) {
		if (iActivityTaskBinder == null || refresh || (iActivityTaskManager != null && !iActivityTaskBinder.isBinderAlive())) {
			iActivityTaskBinder = tasker.getShizukuService(Context.ACTIVITY_TASK_SERVICE);
			iActivityTaskManager = IActivityTaskManager.Stub.asInterface(iActivityTaskBinder);
		} 
		return iActivityTaskManager;
	}

	IActivityTaskManager getIActivityTaskManager() {
		return getIActivityTaskManager(false);
	}

	ITetheringConnector getITetheringConnector(boolean refresh) {
		if (iTetheringConnector == null || refresh || (iTetheringConnector != null && !tetherBinder.isBinderAlive())) {
			tetherBinder = tasker.getShizukuService(Context.TETHERING_SERVICE);
			iTetheringConnector = ITetheringConnector.Stub.asInterface(tetherBinder);
		}
		return iTetheringConnector;
	}

	ITetheringConnector getITetheringConnector() {
		return getITetheringConnector(false);
	}
	
	IWifiManager getIWifiManager(boolean refresh) {
		if (iWifiManager == null || refresh || (iWifiManager != null && !wifiBinder.isBinderAlive())) {
			wifiBinder = tasker.getShizukuService(Context.WIFI_SERVICE);
			iWifiManager = IWifiManager.Stub.asInterface(wifiBinder);
		}
		return iWifiManager;
	}

	IWifiManager getIWifiManager() {
		return getIWifiManager(false);
	}

	void init() {
		hasIActivityManager();
		hasIActivityTaskManager();
		hasITetheringConnector();
		hasIWifiManager();
	}
	
	init();

	return this;
}