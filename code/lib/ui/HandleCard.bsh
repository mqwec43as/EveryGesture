importCommands("lib.ui.card");
importCommands("lib.ui.handle");
importCommands("lib.ui.add");

import com.google.android.material.card.MaterialCardView;
import com.google.android.material.textview.MaterialTextView;
import com.google.android.material.materialswitch.MaterialSwitch;
import android.gesture.Gesture;
import android.gesture.GestureLibraries;
import android.gesture.GestureLibrary;
import android.gesture.Prediction;
import android.gesture.GestureStroke;
import android.gesture.*;
import android.graphics.Canvas;
import android.graphics.Color;
import android.graphics.Paint;
import android.graphics.Path;
import android.graphics.PathMeasure;
import android.graphics.PixelFormat;
import android.graphics.RectF;
import android.graphics.Typeface;
import android.graphics.drawable.Drawable;
import android.graphics.drawable.GradientDrawable;
import android.view.View;
import android.view.ViewGroup;
import android.widget.CompoundButton;
import android.widget.ImageView;
import android.widget.LinearLayout;
import android.widget.RelativeLayout;
import android.widget.TextView;
import com.joaomgcd.taskerm.action.java.ClassImplementation;
import java.util.concurrent.Callable;
import java.util.*;
import android.util.TypedValue;
import android.content.Context;
import bsh.This;
import com.google.android.material.chip.ChipGroup;
import com.google.android.material.chip.Chip;
import android.view.GestureDetector;
import java.util.Collections;
import android.graphics.PorterDuff;
import android.widget.ListView;
import android.widget.BaseAdapter;
import android.content.res.ColorStateList;

HandleCard(This main, This handle) {

	Context CONTEXT = main.activity;
	final This TOP = this;
	This every = main.every;
	This tm = ThemeManager(CONTEXT);
	tm.setTheme(every.themeId);

	Res.Card.Template.BACKGROUND_COLOR = tm.color("colorSurfaceContainerHigh");
	Res.Card.Template.TITLE_COLOR = tm.color("colorOnSurface");
	Res.Card.Template.SUBTITLE_COLOR = tm.color("colorOnSurfaceVariant");
	Res.Card.Template.ICON_COLOR = tm.color("colorPrimary");
	Res.Card.Template.BACKGROUND_RADIUS = tm.dp(24);
	Res.Card.Template.BACKGROUND_RADIUS_ACTIVE = tm.dp(24);
	Res.Card.Template.PADDING = tm.dp(16);

	Res.Card.Snapshot.CONTAINER_WIDTH = 254;
	Res.Card.Snapshot.BACKGROUND_RADIUS = tm.dp(16);
	Res.Card.Snapshot.BACKGROUND_COLOR = tm.color("colorSurface");
	Res.Card.Snapshot.RIGHT_MARGIN = tm.dp(16);
	Res.Card.Snapshot.BOTTOM_MARGIN = 8;
	Res.Card.Snapshot.RADIUS = tm.dp(16);
	Res.Card.Snapshot.MARGIN = 5;
	Res.Card.Snapshot.PADDING = tm.dp(16);

	This drawDialog;
	This topGesture;
	This config = handle.config;
	GestureLibrary library = config.library;
	Map templateCards = new HashMap();
	This snapshotManager;
	MaterialSwitch handleSwitch;
	BaseAdapter adapter;
	List finalGestureList = new ArrayList();
	This handleTemplatesActivity;

	dp(int value) {
		return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, value, CONTEXT.getResources().getDisplayMetrics());
	}

	This Actions = every.Actions != null ? every.Actions : Actions();
	/* Theme-aware handle card styling. */
	Res.Card.HANDLE_NAME_TEXT_SIZE = 24;
	Res.Card.PADDING = dp(8);
	Res.Card.HANDLE_NAME_COLOR = tm.color("colorOnSurface");
	Res.Card.HANDLE_BOTTOM_MARGIN = 8;
	Res.Card.HANDLE_NAME_MARGIN_LEFT = 16;
	Res.Card.HANDLE_NAME_MARGIN_RIGHT = 16;
	Res.Card.HANDLE_RADIUS = dp(24);
	Res.Card.HANDLE_BACKGROUND_COLOR = tm.color("colorSurface");
	Res.Card.HANDLE_BACKGROUND_COLOR_FOCUSED = tm.color("colorSecondary");
	Res.Card.Handle.TOP_ROW_BACKGROUND_COLOR = tm.color("colorSurfaceContainerHigh");
	Res.Card.Handle.TOP_ROW_RADIUS = dp(8);
	Res.Card.HEADER_HEIGHT = dp(50);
	Res.Card.TOP_ROW_PADDING = dp(16);
	Res.Card.Template.SPACE_HEIGHT = dp(2);

	snapshotManager = SnapshotManager(this);

	Runnable runnable = new Runnable() {
		run() {
			try {
				snapshotManager.load();
			} catch (Exception e) {
				log("Error: " + e.getMessage(), "ERROR", TOP);
			}

		}
	};

	every.executor.execute(runnable);

	MaterialCardView cardRoot = new MaterialCardView(CONTEXT);
	cardRoot.setStrokeWidth(0);
	GradientDrawable cardBgRoot = new GradientDrawable();
	cardBgRoot.setCornerRadius(Res.Card.HANDLE_RADIUS);
	cardRoot.setBackground(cardBgRoot);
	LinearLayout.LayoutParams cardRootLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
	cardRoot.setLayoutParams(cardRootLp);

	LinearLayout cardContent = new LinearLayout(CONTEXT);
	cardContent.setOrientation(LinearLayout.VERTICAL);
	cardContent.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

	/* Top row: title + switch and action chips. */
	LinearLayout topRow = new LinearLayout(CONTEXT);
	topRow.setOrientation(LinearLayout.VERTICAL);
	LinearLayout.LayoutParams topLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
	topRow.setLayoutParams(topLp);
	topRow.setMinimumHeight(Res.Card.HEADER_HEIGHT);
	topRow.setPadding(Res.Card.TOP_ROW_PADDING, Res.Card.TOP_ROW_PADDING, Res.Card.TOP_ROW_PADDING, Res.Card.TOP_ROW_PADDING);

	GradientDrawable shape = new GradientDrawable();
	shape.setShape(GradientDrawable.RECTANGLE);
	shape.setColor(Res.Card.Handle.TOP_ROW_BACKGROUND_COLOR);
	shape.setCornerRadius(Res.Card.Handle.TOP_ROW_RADIUS);
	topRow.setBackground(shape);

	showDrawDialog() {
		if (drawDialog == null) {
			drawDialog = DrawDialog(TOP);
		}
		drawDialog.show();
	}


	topListener() {
		onSingleTapConfirmed() {
			showHandleTemplatesActivity();
		}

		onLongPress() {
			showAddActionDialog();
		}

		return this;
	}

	topGesture = SimpleGesture(topRow, topListener());
	topGesture.listen();

	RelativeLayout titleRow = new RelativeLayout(CONTEXT);
	titleRow.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

	/* Handle name. */
	TextView handleTV = new TextView(CONTEXT);
	handleTV.setText(config.handleName);
	handleTV.setTextSize(Res.Card.HANDLE_NAME_TEXT_SIZE);
	handleTV.setTypeface(null, Typeface.BOLD);
	handleTV.setTextColor(Res.Card.HANDLE_NAME_COLOR);
	RelativeLayout.LayoutParams handleParams = new RelativeLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
	handleParams.addRule(RelativeLayout.ALIGN_PARENT_LEFT);
	handleParams.addRule(RelativeLayout.CENTER_VERTICAL);
	titleRow.addView(handleTV, handleParams);

	/* Handle switch. */
	handleSwitch = new MaterialSwitch(CONTEXT);
	handleSwitch.setText("");
	int switchPadding = 12;
	handleSwitch.setPadding(switchPadding, switchPadding, switchPadding, switchPadding);
	handleSwitch.setChecked(handle.isAdded());
	handleSwitch.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
		onCheckedChanged(CompoundButton button, boolean checked) {
			if (checked) {
				every.showHandle(config.handleName);
			} else {
				every.removeHandle(config.handleName);
			}
			return true;
		}
	});

	RelativeLayout.LayoutParams handleSwitchParams = new RelativeLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
	handleSwitchParams.addRule(RelativeLayout.ALIGN_PARENT_RIGHT);
	handleSwitchParams.addRule(RelativeLayout.CENTER_VERTICAL);
	titleRow.addView(handleSwitch, handleSwitchParams);

	LinearLayout chipRow = new LinearLayout(CONTEXT);
	// chipRow.setOrientation(LinearLayout.VERTICAL);
	LinearLayout.LayoutParams chipRowParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
	chipRowParams.topMargin = dp(4);
	chipRow.setLayoutParams(chipRowParams);
	chipRow.setPadding(0, dp(4), 0, 0);

	ChipGroup handleActionChips = new ChipGroup(CONTEXT);
	LinearLayout.LayoutParams chipGroupParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
	handleActionChips.setLayoutParams(chipGroupParams);
	handleActionChips.setSingleLine(false);
	handleActionChips.setChipSpacingVertical(tm.dp(-8));
	chipRow.addView(handleActionChips);

	createActionChip(String label, String startIconPath, Runnable action) {
		Chip chip = new Chip(CONTEXT);
		chip.setText(label);
		chip.setChipIconVisible(true);
		chip.setClickable(true);
		chip.setOnClickListener(new View.OnClickListener() {
			onClick(View v) {
				action.run();
			}
		});

		ColorStateList color = ColorStateList.valueOf(tm.color("colorOnSurface"));
		chip.setChipIconTint(color);

		if (every.MAIN_DIRECTORY != void) startIconPath = every.MAIN_DIRECTORY + "/res/" + startIconPath;
		String editIconPath = "main/edit.svg";
		if (every.MAIN_DIRECTORY != void) editIconPath = every.MAIN_DIRECTORY + "/res/" + editIconPath;
		startIcon() {
			onSuccess(Drawable result) {
				chip.setChipIcon(result);
			}
			return this;
		}
		loadSvgIcon(CONTEXT, editIconPath, startIcon());

		endIcon() {
			onSuccess(Drawable result) {
				chip.setCloseIcon(result);
				chip.setCloseIconVisible(true);
			}
			return this;
		}
		loadSvgIcon(CONTEXT, startIconPath, endIcon());

		return chip;
	}

	Object[][] handleActions = new Object[][] {
		{
			"Gestures",
			"main/gesture.svg",
			new Runnable() {
				run() {
					showDrawDialog();
				}
			}
		},
		{
			"Properties",
			"main/handle.svg",
			new Runnable() {
				run() {
					HandleEdit(TOP);
				}
			}
		},
		{
			"Edit Rules",
			"main/tasks.svg",
			new Runnable() {
				run() {
					showHandleTemplatesActivity();
				}
			}
		}
	};

	for (int i = 0; i < handleActions.length; i++) {
		Object[] actionItem = handleActions[i];
		String actionLabel = (String) actionItem[0];
		String actionPath = (String) actionItem[1];
		Runnable actionRunnable = (Runnable) actionItem[2];
		handleActionChips.addView(createActionChip(actionLabel, actionPath, actionRunnable));
	}

	topRow.addView(titleRow);
	topRow.addView(chipRow);

	cardContent.addView(topRow);
	cardRoot.addView(cardContent);

	addSpacer(View target) {
		View spacer = new View(CONTEXT);
		spacer.setBackgroundColor(Color.TRANSPARENT);
		spacer.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, Res.Card.Template.SPACE_HEIGHT));
		target.addView(spacer);
		return spacer;
	}

	refreshSwitch() {
		if (handle.isAdded()) {
			handleSwitch.setChecked(true);
		} else {
			handleSwitch.setChecked(false);
		}
	}

	notifyChanged() {
		if (handleTemplatesActivity != null) handleTemplatesActivity.notifyChanged();
	}

	refreshGestureList() {
		if (handleTemplatesActivity != null) handleTemplatesActivity.refreshGestureList();
	}

	showHandleTemplatesActivity() {
		try {
			if (handleTemplatesActivity == null) {
				handleTemplatesActivity = HandleTemplatesActivity(TOP);
				handleTemplatesActivity.show();
			} else {
				handleTemplatesActivity.show();
			}
		} catch (Exception e) {
			log("Error: " + e.getMessage(), "ERROR", TOP);
			tasker.showToast(e.getMessage(), "Error showing dialog");
		}
	}

	getView() {
		return cardRoot;
	}

	removeTemplate(String name) {
		config.deleteGesture(name);
		This card = templateCards.get(name);
		if (card != null) templateCards.remove(name);
		refreshGestureList();
	}

	getSnapshotDrawable(String templateName) {
		if (templateCards.get(templateName) != null) {
			return templateCards.get(templateName).getSnapshotDrawable();
		}
		return null;
	}

	showAddActionDialog() {
		addListener() {
			onSuccess(Map selected) {
				addNewAction(TOP, (String) selected.get("title"));
			}
			return this;
		}
		This addConfig = main.selection.getDialogConfig(config.handleName, "Add Action", addListener());
		addConfig.multiSelect = false;
		This addDialog = ListDialog(addConfig);
		addDialog.show();
	}

	return this;

}