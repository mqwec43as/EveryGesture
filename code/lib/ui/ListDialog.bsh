/* ───────────────────────────────────────────────────────────────
 * Create list dialog by passing config
 * Requires Tasker v6.7.8 or higher
 ─────────────────────────────────────────────────────────────── */
This ListDialog(This config) {

	String title = config.title == void ? null : config.title;
	boolean showFilter = config.showFilter == void ? false : config.showFilter;
	boolean isMulti = config.multiSelect == void ? false : config.multiSelect;
	List preSelect = config.preSelect == void ? new ArrayList() : config.preSelect;
	long timeout = config.timeout == void ? 0 : config.timeout;
	int iconSize = config.iconSize == void ? 40 : config.iconSize;
	float dimAmount = config.dimAmount == void ? 0.0f: config.dimAmount;
	float maxWidth = config.maxWidth == void ? 0.5f: config.maxWidth;
	int themeId = config.themeId == void ? 0 : config.themeId;
	boolean sort = config.sort == void ? false : config.sort;
	boolean useOverlay = config.useOverlay == void ? false : config.useOverlay;
	boolean useAccessibility = config.useAccessibility == void ? false : config.useAccessibility;
	int displayId = config.displayId == void ? 0 : config.displayId;
	String text = config.text == void ? null : config.text;
	boolean useTags = config.useTags == void ? false : config.useTags;
	boolean multiTags = config.multiTags == void ? false : config.multiTags;
	boolean removeManually = config.removeManually == void ? false : config.removeManually;

	/* Height Logic Setup */
	Object rawMaxH = config.maxHeight == void ? 0.8 : config.maxHeight;
	Object rawMaxL = config.maxHeightList == void ? 0.5 : config.maxHeightList;

	final Map iconCache = new HashMap();
	FloatingToolbarLayout root;
	Activity activity;
	Context activityContext;
	Context layoutContext;
	ArrayList selectedItems = new ArrayList();
	List filteredList = new ArrayList();
	ListView listView;
	TextInputEditText filterInput;
	TextInputLayout filterWrapper;
	MaterialToolbar toolbar;
	MaterialTextView textView;
	LinearLayout mainContainer;
	BaseAdapter adapter;
	LinearLayout buttonsContainer;
	MaterialButton cBtn;
	MaterialButton okButton;
	This tm;
	This monitor;
	WindowManager getWindowManager();
	PackageManager pm;
	List tagsList;
	List tagsChips = new ArrayList();
	ChipGroup tagsGroup;

	WindowManager.LayoutParams params;

	List originalList = config.itemList;
	if (originalList == null) originalList = new ArrayList();
	if (sort) {
		originalList.sort(new Comparator() {
			compare(Object o1, Object o2) {
				String label1 = ((Map) o1).get("title");
				String label2 = ((Map) o2).get("title");
				return label1.compareToIgnoreCase(label2);
			}
		});
	}

	boolean hasMethod(String methodName, Class[] classes) {
		if (classes == null) classes = new Class[] {};
		return config.namespace.getMethod(methodName, classes) != null;
	}

	boolean hasSuccess = hasMethod("onSuccess", new Class[] { HashMap.class });
	boolean hasSuccessMulti = hasMethod("onSuccess", new Class[] { ArrayList.class });
	boolean hasCancel = hasMethod("onCancel", null);
	boolean hasTimeout = hasMethod("onTimeout", null);
	boolean hasDismiss = hasMethod("onDismiss", null);
	boolean hasAttach = hasMethod("onAttach", null);
	boolean hasDetach = hasMethod("onDetach", null);
	boolean hasCreated = hasMethod("onCreated", null);
	boolean hasDestroyed = hasMethod("onDestroyed", null);

	activityListener() {
		onCreated(ActivityLifecycleEvent event) {
			if (hasCreated) config.onCreated();
		}

		onDestroyed(ActivityLifecycleEvent event) {
			if (hasDestroyed) config.onDestroyed();
			filterWrapper = null;
			filterInput = null;
			toolbar = null;
			textView = null;
			tagsGroup = null;
		}

		// ! Might need to remove later if Tasker allows Activity to not be excluded in recents
		// Remove when activity is stopped
		onStopped(ActivityLifecycleEvent event) {
			event.activity.finish();
		}

		return this;
	}

	CompletableSubject waitTimeout = CompletableSubject.create();

	Context getContext() {
		return layoutContext;
	}

	WindowManager getWindowManager() {
		if (getWindowManager() == null) {
			getWindowManager() = getContext().getSystemService(Context.WINDOW_SERVICE);
		}
		return getWindowManager();
	}

	boolean isActivityContext() {
		return getContext() instanceof Activity;
	}

	boolean isAccessibilityContext() {
		return getContext() instanceof android.accessibilityservice.AccessibilityService;
	}

	void remove() {
		if (isActivityContext() && activity != null) {
			activity.finish();
		} else if (useOverlay && isAdded()) {
			try {
				getWindowManager().removeView(root);
			} catch (Exception e) {}
		}

		if (timeout != 0 && !waitTimeout.hasComplete()) waitTimeout.onComplete();
	}

	void attachStateListener() {
		View.OnAttachStateChangeListener stateListener = new View.OnAttachStateChangeListener() {
			onViewAttachedToWindow(View v) {
				if (hasAttach) config.onAttach();
			}
			onViewDetachedFromWindow(View v) {
				if (!removeManually) remove();
				if (hasDetach) config.onDetach();
			}
		};

		if (isActivityContext() && activity != null) {
			View decorView = activity.getWindow().getDecorView();
			decorView.addOnAttachStateChangeListener(stateListener);
		} else {
			root.addOnAttachStateChangeListener(stateListener);
		}
	}

	boolean isIconRecycled(Drawable iconDrawable) {
		if (iconDrawable == null) return false;
		if (iconDrawable instanceof BitmapDrawable) {
			return ((BitmapDrawable) iconDrawable).getBitmap().isRecycled();
		} else {
			return false;
		}
	}

	/*
	 * Tags are stored in "tags" as String[] array in itemlist
	 */
	List getTagsList() {
		if (tagsList == null) {
			tagsList = new ArrayList();

			if (originalList == null || originalList.isEmpty() || !useTags) return tagsList;

			for (Map item: originalList) {
				if (item.containsKey("tags")) {
					Object itemTags = item.get("tags");
					if (itemTags instanceof String[]) {
						if (!multiTags) multiTags = itemTags.length > 1;
						tagsList.addAll(Arrays.asList(itemTags));
					}
				}
			}

			// Remove duplicates and sort order
			Set set = new LinkedHashSet(tagsList);
			tagsList.clear();
			tagsList.addAll(set);
			Collections.sort(tagsList, String.CASE_INSENSITIVE_ORDER);
		}

		return tagsList;
	}

	/* ───────────────────────────────────────────────────────────────
	 * Methods to filter and control tags
	 ─────────────────────────────────────────────────────────────── */

	/*
	 * Get checked tags from chip list
	 * The list is written by attachChipTags()
	 */
	List getCheckedTags() {
		List checkedTags = new ArrayList();
		if (tagsChips == null || tagsChips.isEmpty()) return checkedTags;

		for (Chip chip: tagsChips) {
			if (chip.isChecked()) checkedTags.add(chip.getText());
		}

		return checkedTags;
	}

	// * Check if tags array contains targetTag
	boolean containsTag(String[] tags, String targetTag) {
		for (String tag: tags) {
			if (targetTag.equals(tag)) {
				return true;
			}
		}
		return false;
	}

	/*
	 * Check if item has all checked tags
	 * All tags means that all checked tags must be present in the item
	 * For example {"tags": ["tag1", "tag2", "tag3"]} and checkedTags=["tag1", "tag2"]
	 * will return true
	 */
	boolean itemHasTags(Map item, List checkedTags, boolean hasAllTags) {
		if (item == null || checkedTags == null || checkedTags.isEmpty()) {
			return false;
		}
		if (!item.containsKey("tags")) {
			return false;
		}
		Object itemTagsObj = item.get("tags");
		if (!(itemTagsObj instanceof String[])) {
			return false;
		}
		String[] tags = (String[]) itemTagsObj;
		if (hasAllTags) {
			for (String requiredTag: checkedTags) {
				if (requiredTag == null) {
					continue;
				}
				if (!containsTag(tags, requiredTag)) {
					return false;
				}
			}
			return true;
		} else {
			for (String tag: tags) {
				if (tag != null && checkedTags.contains(tag)) {
					return true;
				}
			}
			return false;
		}
	}

	/* 
	 * Helper method to check if item title or subtitle contains text
	 * Used by the updateList()
	 */
	boolean itemHasText(Map item, String text) {
		String title = item.get("title").toString().toLowerCase();
		String subTitle = item.get("subtitle") != null ? item.get("subtitle").toString().toLowerCase() : "";
		return title.contains(text) || subTitle.contains(text);
	}

	/*
	 * Update the filtered list
	 * This method is called when filterInput or tagsChips are changed
	 */
	void updateList() {
		String filterQuery = filterInput != null ? filterInput.getText().toString().toLowerCase() : "";
		List checkedTags = getCheckedTags();
		boolean hasCheckedTags = !checkedTags.isEmpty();
		filteredList.clear();
		if (filterQuery.isEmpty() && (!useTags || !hasCheckedTags)) {
			filteredList.addAll(originalList);
		} else {
			for (Map itemMap: originalList) {
				boolean included = true;

				if (hasCheckedTags && useTags) {
					included = itemHasTags(itemMap, checkedTags, true);
				}

				if (included && !filterQuery.isEmpty()) {
					included = itemHasText(itemMap, filterQuery);
				}

				if (included) filteredList.add(itemMap);
			}
		}
		adapter.notifyDataSetChanged();
	}

	/* ───────────────────────────────────────────────────────────────
	 * Methods to attach and set views
	 ─────────────────────────────────────────────────────────────── */

	/*
	 * Add chip tags if getTagsList() is not empty
	 */
	void attachChipTags() {
		if (tagsGroup == null) {
			tagsGroup = new ChipGroup(getContext());
			tagsGroup.setSingleLine(true);
			int spacing = tm.dp(-4);
			tagsGroup.setChipSpacingVertical(spacing);
			tagsGroup.setLayoutParams(new LinearLayout.LayoutParams(
					LinearLayout.LayoutParams.WRAP_CONTENT,
					LinearLayout.LayoutParams.WRAP_CONTENT
			));

			HorizontalScrollView chipScrollView = new HorizontalScrollView(getContext());
			FrameLayout.LayoutParams scrollParams = new FrameLayout.LayoutParams(
					FrameLayout.LayoutParams.WRAP_CONTENT, 
					FrameLayout.LayoutParams.MATCH_PARENT
			);
			chipScrollView.setLayoutParams(scrollParams);
			chipScrollView.setHorizontalScrollBarEnabled(false); 
			chipScrollView.addView(tagsGroup);
			
			mainContainer.addView(chipScrollView);
		}

		getTagsList();
		if (tagsList.isEmpty()) return;
		
		tagsGroup.setSingleSelection(!multiTags);
		for (String tag: tagsList) {
			Chip tagChip = new Chip(getContext());
			tagChip.setText(tag);
			tagChip.setCheckable(true);
			tagChip.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
				onCheckedChanged(CompoundButton buttonView, boolean isChecked) {
					updateList();
				}
			});
			tagsGroup.addView(tagChip);
			tagsChips.add(tagChip);
		}
	}

	/*
	 * Set title if titleText is not empty
	 * Will hide toolbar if the title text is empty or null
	 */
	void setTitle(String titleText) {
		if (toolbar == null) {
			toolbar = new MaterialToolbar(getContext());
			toolbar.setTitleCentered(true);
			mainContainer.addView(toolbar);
		}

		if (titleText != null && !titleText.isEmpty()) {
			toolbar.setTitle(titleText);
			toolbar.setVisibility(View.VISIBLE);
		} else {
			toolbar.setVisibility(View.GONE);
		}
	}

	/*
	 * Set text if subtext is not empty
	 * Will hide text if subtext is empty or null
	 */
	void setText(String subtext) {
		if (textView == null) {
			textView = new MaterialTextView(getContext());
			textView.setTextSize(14);
			textView.setPadding(0, 0, 0, dp(4));
			textView.setMaxLines(3);
			textView.setEllipsize(TextUtils.TruncateAt.END);
			mainContainer.addView(textView);
		}
		if (text != null && !text.isEmpty()) {
			textView.setText(text);
			textView.setVisibility(View.VISIBLE);
		} else {
			textView.setVisibility(View.GONE);
		}
	}

	/*
	 * Show filter input
	 * See updateList() on how it updates the list based on the filter 
	 */
	void showFilterInput(boolean isVisible) {
		if (filterWrapper == null) {
			filterWrapper = new TextInputLayout(getContext());
			filterWrapper.setHint("Search...");
			filterWrapper.setBoxBackgroundMode(2);
			mainContainer.addView(filterWrapper);
			filterWrapper.setEndIconMode(-1);
			filterWrapper.setEndIconOnClickListener(new View.OnClickListener() {
				onClick(View view) {
					InputMethodManager imm = getContext().getSystemService(Context.INPUT_METHOD_SERVICE);
					imm.hideSoftInputFromWindow(view.getWindowToken(), 0);
				}
			});

			Drawable hideIcon = tm.attr("mw_hardware_keyboard_hide");
			filterWrapper.setEndIconDrawable(hideIcon);

			filterInput = new TextInputEditText(filterWrapper.getContext());
			filterWrapper.addView(filterInput);
			filterInput.addTextChangedListener(new TextWatcher() {
				beforeTextChanged(CharSequence sequence, int start, int count, int after) {}
				onTextChanged(CharSequence sequence, int start, int b, int c) {
					updateList();
				}
				afterTextChanged(Editable sequence) {}
			});
		}

		if (isVisible) {
			filterWrapper.setVisibility(View.VISIBLE);
		} else {
			filterWrapper.setVisibility(View.GONE);
		}
	}


	/*
	 * Attach item click listener
	 * Long click is only available for single selection
	 */
	void attachItemListener() {
		listView.setOnItemClickListener(new AdapterView.OnItemClickListener() {
			onItemClick(AdapterView p, View v, int pos, long id) {
				Map clicked = (Map) filteredList.get(pos);
				clicked.put("index", pos);
				if (isMulti) {
					int index = -1;
					for (int i = 0; i < selectedItems.size(); i++) {
						if (selectedItems.get(i) == clicked) {
							index = i;
							break;
						}
					}
					if (index != -1) selectedItems.remove(index);
					else selectedItems.add(clicked);
					adapter.notifyDataSetChanged();
				} else {
					if (!removeManually) remove();
					clicked.put("longClick", false);
					if (hasSuccess) config.onSuccess(clicked);
				}
			}
		});

		if (!isMulti) {
			listView.setOnItemLongClickListener(new AdapterView.OnItemLongClickListener() {
				onItemLongClick(AdapterView p, View v, int pos, long id) {
					if (!removeManually) remove();
					Map clicked = filteredList.get(pos);
					clicked.put("index", pos);
					clicked.put("longClick", true);
					if (hasSuccess) config.onSuccess(clicked);
					return true;
				}
			});
		}

	}

	/*
	 * Create the layout from the context passed from show()
	 */
	void createLayout(Context layoutContext) {
		super.layoutContext = layoutContext;

		if (isActivityContext()) {
			activity = (Activity) layoutContext;
			monitor = SimpleActivityMonitor(getContext(), activityListener());
		}

		if (!isActivityContext() && displayId != 0) {
			DisplayManager dm = getContext().getSystemService(Context.DISPLAY_SERVICE);
			if (dm != null) {
				Display targetDisplay = dm.getDisplay(displayId);
				if (targetDisplay != null) {
					layoutContext = getContext().createDisplayContext(targetDisplay);
					super.layoutContext = layoutContext;
				}
			}
		}

		pm = getContext().getPackageManager();

		DisplayMetrics metrics = getContext().getResources().getDisplayMetrics();
		int screenW = metrics.widthPixels;
		int screenH = metrics.heightPixels;
		int dialogWidth = WindowManager.LayoutParams.MATCH_PARENT;

		if (screenW > screenH) {
			dialogWidth = (int)(screenW * maxWidth);
			if (dialogWidth > screenW) {
				dialogWidth = WindowManager.LayoutParams.MATCH_PARENT;
			}
		}

		if (isActivityContext()) {
			Window window = getContext().getWindow();
			window.requestFeature(Window.FEATURE_NO_TITLE);
			window.setLayout(dialogWidth, WindowManager.LayoutParams.WRAP_CONTENT);
			window.setBackgroundDrawableResource(android.R.color.transparent);
			window.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE);
			window.addFlags(WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS |
				WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);

			params = window.getAttributes();
			params.gravity = Gravity.BOTTOM;
			if (dimAmount != 0.0f) {
				window.addFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
				params.dimAmount = dimAmount;
			}

			window.setAttributes(params);
		} else {
			getWindowManager() = getContext().getSystemService(Context.WINDOW_SERVICE);
			int overlayType = isAccessibilityContext() ? WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY : WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY;

			int flags = WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL |
				WindowManager.LayoutParams.FLAG_WATCH_OUTSIDE_TOUCH |
				WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED;

			if (!showFilter) flags |= WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE;

			params = new WindowManager.LayoutParams(
				dialogWidth,
				WindowManager.LayoutParams.WRAP_CONTENT,
				overlayType,
				flags,
				android.graphics.PixelFormat.TRANSLUCENT
			);
			params.gravity = Gravity.BOTTOM;
			if (dimAmount != 0.0f) {
				params.flags |= WindowManager.LayoutParams.FLAG_DIM_BEHIND;
				params.dimAmount = dimAmount;
			}
		}

		tm = ThemeManager(getContext());
		if (themeId == 0) tm.setThemeDark();
		else getContext().setTheme(themeId);

		dp(int dp) {
			return tm.dp(dp);
		}

		root = new FloatingToolbarLayout(getContext());
		root.setBackgroundColor(Color.TRANSPARENT);

		mainContainer = new LinearLayout(getContext());
		mainContainer.setOrientation(LinearLayout.VERTICAL);

		LinearLayout.LayoutParams mainLp = new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT);
		mainLp.gravity = Gravity.BOTTOM;
		mainContainer.setLayoutParams(mainLp);
		mainContainer.setPadding(dp(20), dp(20), dp(20), dp(20));

		GradientDrawable shape = new GradientDrawable();
		shape.setCornerRadius(dp(28));
		shape.setColor((int) tm.color("colorSurfaceContainerHigh"));
		mainContainer.setBackground(shape);
		mainContainer.setClipToOutline(true);

		setTitle(title);
		setText(text);
		showFilterInput(showFilter);
		attachChipTags();

		listView = new ListView(getContext());
		mainContainer.addView(listView);
		listView.setDivider(null);
		listView.setDividerHeight(0);

		LinearLayout.LayoutParams listLp = new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0f);
		listView.setLayoutParams(listLp);

		filteredList = new ArrayList(originalList);

		if (isMulti && !preSelect.isEmpty()) {
			for (int i = 0; i < originalList.size(); i++) {
				Map item = (Map) originalList.get(i);
				for (int j = 0; j < preSelect.size(); j++) {
					Object pre = preSelect.get(j);

					boolean hasTitle = item.containsKey("title");
					boolean hasSubtitle = item.containsKey("subtitle");
					boolean isTitleMatch = item.get("title").equals(pre.get("title"));
					boolean isSubtitleMatch;

					if (hasSubtitle) isSubtitleMatch = item.get("subtitle").equals(pre.get("subtitle"));
					if (!isTitleMatch && !isSubtitleMatch) continue;

					boolean isMatch;

					if (hasTitle && hasSubtitle && isTitleMatch && isSubtitleMatch) {
						isMatch = true;
					} else if (hasTitle && !hasSubtitle && isTitleMatch) {
						isMatch = true;
					}

					if (!selectedItems.contains(item) && isMatch) {
						selectedItems.add(item);
						break;
					}
				}
			}
		}

		ClassImplementation adapterHandler = new ClassImplementation() {
			run(Callable superCaller, String methodName, Object[] args) {
				if (methodName.equals("getCount")) return filteredList.size();
				if (methodName.equals("getItem")) return filteredList.get((Integer) args[0]);
				if (methodName.equals("getItemId")) return ((Integer) args[0]).longValue();
				if (methodName.equals("getView")) {
					int pos = (Integer) args[0];
					View adapterView = (View) args[1];
					Map itemData = (Map) filteredList.get(pos);
					Object sub = itemData.get("subtitle");
					boolean hasSub = sub != null && !sub.toString().equals("");
					LinearLayout row;
					ImageView iconView;
					TextView titleTextView, subtitleTextView;
					Drawable iconDrawable = itemData.get("icon");
					String iconPath = itemData.get("iconPath");
					This iconThis = itemData.get("iconThis");
					Object getIconObj = itemData.get("getIcon");
					boolean hasGetIcon = getIconObj != null && getIconObj != void && (getIconObj instanceof Callable);
					boolean hasIcon = iconDrawable != null && iconDrawable != void;
					boolean hasIconPath = iconPath != null && !iconPath.equals("");

					if (adapterView == null) {
						row = new LinearLayout(getContext());
						row.setOrientation(0);
						row.setGravity(Gravity.CENTER_VERTICAL);
						row.setPadding(dp(0), dp(12), dp(0), dp(12));

						iconView = new ImageView(getContext());
						iconView.setLayoutParams(new LinearLayout.LayoutParams(dp(iconSize), dp(iconSize)));
						iconView.setPadding(0, 0, dp(16), 0);
						row.addView(iconView);

						LinearLayout itemLayout = new LinearLayout(getContext());
						itemLayout.setOrientation(1);
						itemLayout.setLayoutParams(new LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0f));

						titleTextView = new MaterialTextView(getContext());
						titleTextView.setTextSize(16);
						if (hasSub) {
							Typeface currentTypeface = titleTextView.getTypeface();
							titleTextView.setTypeface(Typeface.create(currentTypeface, 600, false));
						}
						titleTextView.setEllipsize(TextUtils.TruncateAt.END);
						itemLayout.addView(titleTextView);

						subtitleTextView = new MaterialTextView(getContext());
						subtitleTextView.setTextSize(14);
						subtitleTextView.setTextColor(subtitleTextView.getTextColors().withAlpha(190));
						itemLayout.addView(subtitleTextView);
						row.addView(itemLayout);

						if (isMulti) {
							CheckBox checkBox = new CheckBox(getContext());
							checkBox.setFocusable(false);
							checkBox.setClickable(false);
							row.addView(checkBox);
						}
					} else {
						row = (LinearLayout) adapterView;
						iconView = (ImageView) row.getChildAt(0);
						LinearLayout itemLayout = (LinearLayout) row.getChildAt(1);
						titleTextView = (TextView) itemLayout.getChildAt(0);
						subtitleTextView = (TextView) itemLayout.getChildAt(1);
					}

					iconView.setTag(itemData);

					titleTextView.setText((String) itemData.get("title"));
					subtitleTextView.setText(hasSub ? sub.toString() : "");
					subtitleTextView.setVisibility(hasSub ? View.VISIBLE : View.GONE);

					if (isMulti) {
						CheckBox checkBox = (CheckBox) row.getChildAt(row.getChildCount() - 1);
						boolean found = false;
						for (int k = 0; k < selectedItems.size(); k++) {
							if (selectedItems.get(k).equals(itemData)) {
								found = true;
								break;
							}
						}
						checkBox.setChecked(found);
					}

					if (hasIcon) {
						try {
							if (isIconRecycled(iconDrawable)) {
								itemData.put("icon", null);
								iconView.setVisibility(View.GONE);
							} else {
								iconView.setImageDrawable((Drawable) iconDrawable);
								iconView.setVisibility(View.VISIBLE);
							}
						} catch (Exception e) {
							iconView.setVisibility(View.GONE);
						}
					} else if (hasGetIcon) {
						iconView.setVisibility(View.VISIBLE);
						Boolean isLoading = itemData.get("isLoadingIcon");
						if (isLoading == null || !isLoading.booleanValue()) {
							try {
								itemData.put("isLoadingIcon", true);
								final Callable iconCallable = (Callable) getIconObj;
								try {
									final Drawable loadedIcon = iconCallable.call();
									if (loadedIcon != null) {
										itemData.put("icon", loadedIcon);
										itemData.remove("getIcon");
										if (iconView.getTag() == itemData) {
											iconView.setImageDrawable(loadedIcon);
											iconView.setVisibility(View.VISIBLE);
										}
									}
								} catch (Exception e) {
									/* Ignore icon retrieval errors */
								} finally {
									itemData.put("isLoadingIcon", false);
								}
							} catch (e) {
								log(e.getMessage(), "ERROR", TOP);
								itemData.put("isLoadingIcon", false);
							}
						}
					} else if (hasIconPath) {
						listener() {
							onSuccess(Drawable result) {
								result.setColorFilter(tm.color("colorPrimary"), PorterDuff.Mode.SRC_IN);
								iconView.setImageDrawable(result);
								itemData.put("icon", result);
							}
							return this;
						}
						loadSvgIcon(getContext(), iconPath, listener());
					} else if ("app".equals(itemData.get("type")) && sub != null) {
						iconView.setVisibility(0);
						Drawable dr = (Drawable) iconCache.get(sub.toString());
						if (dr == null) {
							try {
								dr = pm.getApplicationIcon(sub.toString());
								iconCache.put(sub.toString(), dr);
							} catch (Exception e) {}
						}
						iconView.setImageDrawable(dr);
					} else if (!hasIcon) {
						iconView.setVisibility(8);
					}
					return row;
				}
				return superCaller.call();
			}
		};

		adapter = tasker.implementClass(BaseAdapter.class, adapterHandler);
		listView.setAdapter(adapter);

		buttonsContainer = new LinearLayout(getContext());
		buttonsContainer.setOrientation(0);
		buttonsContainer.setGravity(Gravity.END);
		buttonsContainer.setPadding(0, dp(8), 0, 0);
		mainContainer.addView(buttonsContainer);

		cBtn = new MaterialButton(getContext());
		cBtn.setText("CANCEL");
		cBtn.setOnClickListener(new View.OnClickListener() {
			onClick(View v) {
				if (hasCancel) config.onCancel();
				remove();
			}
		});

		buttonsContainer.addView(cBtn);
		if (isMulti) {
			okButton = new MaterialButton(getContext());
			LinearLayout.LayoutParams ol = new LinearLayout.LayoutParams(-2, -2);
			ol.leftMargin = dp(12);
			okButton.setLayoutParams(ol);
			okButton.setText("OK");
			okButton.setOnClickListener(new View.OnClickListener() {
				onClick(View v) {
					if (!removeManually) remove();
					if (hasSuccessMulti) config.onSuccess(selectedItems);
				}
			});
			buttonsContainer.addView(okButton);
		}

		attachItemListener();
		attachStateListener();

		root.addView(mainContainer);
		if (isActivityContext()) {
			activity.setContentView(root);
		} else {
			getWindowManager().addView(root, params);
		}
	}

	void show() {
		if (!isAdded()) {
			if (!useOverlay) {
				tasker.doWithActivity(new java.util.function.Consumer() {
					accept(Activity activity) {
						createLayout(activity);
					}
				});
			} else {
				if (useAccessibility) {
					AccessibilityService a11yService = tasker.getAccessibilityService();
					if (a11yService == null) {
						throw new JavaCodeException("Accessibility Service is not running.");
					}
					createLayout(a11yService);
				} else {
					createLayout(context);
				}
			}

			if (timeout != 0) {
				boolean isSuccess = waitTimeout.blockingAwait(timeout, TimeUnit.MILLISECONDS);
				if (hasTimeout && !isSuccess) config.onTimeout();
				remove();
				return isSuccess;
			}
		}
	}

	void toggle() {
		if (isRemoved()) show();
		else remove();
	}

	boolean isAdded() {
		if (root == null) return false;
		return root.getParent() != null && root.isAttachedToWindow();
	}

	boolean isHidden() {
		if (root == null) return false;
		return root.getVisibility() == View.GONE && isAdded();
	}

	boolean isShowing() {
		if (root == null) return false;
		return root.getVisibility() == View.VISIBLE && isAdded();
	}

	boolean isRemoved() {
		if (root == null) return false;
		return !isAdded();
	}

	void hide() {
		if (useOverlay) {
			if (isShowing()) root.setVisibility(View.GONE);
		} else {
			throw new JavaCodeException("Dialog is not created as overlay.");
		}
	}

	void unhide() {
		if (useOverlay) {
			if (isAdded()) root.setVisibility(View.VISIBLE);
		} else {
			throw new JavaCodeException("Dialog is not created as overlay.");
		}
	}

	return this;

}