import com.google.android.material.materialswitch.MaterialSwitch;
import android.graphics.Color;
import android.graphics.Typeface;
import android.graphics.drawable.Drawable;
import android.graphics.drawable.GradientDrawable;
import android.view.View;
import android.view.ViewGroup;
import android.widget.ImageView;
import android.widget.LinearLayout;
import android.widget.TextView;
import java.util.*;
import android.util.TypedValue;
import android.content.Context;
import bsh.This;
import android.graphics.PorterDuff;

ActionRow(This templateCard, String actionType, Map actionMap, This pickerListener) {
	Context CONTEXT = templateCard.CONTEXT;
	This tm = templateCard.tm;
	final This TOP = this;
    This every = templateCard.every;
	This Actions = every.Actions != null ? every.Actions : Actions();
    
    Res.Card.ICON_SIZE = 80;
	Res.Card.ICON_MARGIN = 8;
	Res.Template.ACTION_NAME_TEXT_SIZE = 14;

	String actionDisplayName;
	try {
		actionDisplayName = Actions.getDisplayText(actionMap);
	} catch (e) {
		log("Enable to get action display name for " + actionType + ": " + e.getMessage(), "ERROR");
		actionDisplayName = "Error";
	}

	LinearLayout row = new LinearLayout(CONTEXT);
	row.setOrientation(0);
	row.setGravity(Gravity.CENTER_VERTICAL);
	LinearLayout.LayoutParams rowParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
	// rowParams.setMargins(0, 8, 0, 8);
	row.setLayoutParams(rowParams);
	row.setPadding(8, 8, 8, 8);

	String actionSvgPath = actionType + ".svg";
	if (every.MAIN_DIRECTORY != void) actionSvgPath = every.MAIN_DIRECTORY + "/res/actions/" + actionSvgPath;
	ImageView icon = new ImageView(CONTEXT);
	LinearLayout.LayoutParams iconParams = new LinearLayout.LayoutParams(Res.Card.ICON_SIZE, Res.Card.ICON_SIZE);
	iconParams.rightMargin = Res.Card.ICON_MARGIN;
	iconParams.topMargin = 0;
	iconParams.bottomMargin = 0;
	icon.setLayoutParams(iconParams);

	listener() {
		onSuccess(Drawable result) {
			result.setColorFilter(tm.color("colorOnSurfaceVariant"), PorterDuff.Mode.SRC_IN);
			icon.setImageDrawable(result);
		}
		onFileNotExist() {
			log("SVG not found: " + actionSvgPath);
		}
		return this;
	}

	loadSvgIcon(CONTEXT, actionSvgPath, listener());

	LinearLayout textLayout = new LinearLayout(CONTEXT);
	textLayout.setOrientation(1);
	LinearLayout.LayoutParams textParams = new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0f);
	textLayout.setLayoutParams(textParams);
	// textLayout.setPadding(8, 0, 0, 0);

	TextView actionDisplayTV = new TextView(CONTEXT);
	actionDisplayTV.setText(actionDisplayName);
	actionDisplayTV.setTextSize(Res.Template.ACTION_NAME_TEXT_SIZE);
	actionDisplayTV.setTextColor(tm.color("colorOnSurfaceVariant"));
	actionDisplayTV.setTypeface(null, Typeface.BOLD);
	textLayout.addView(actionDisplayTV);

	row.addView(icon);
	row.addView(textLayout);
	row.setOnClickListener(new View.OnClickListener() {
		onClick(View v) {
			Map map = actionMap.clone();
			ActionPicker(map, pickerListener);
		}
	});
	return row;
}