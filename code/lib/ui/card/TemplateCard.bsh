TemplateCard(This handleCard, String gestureName) {
	Context CONTEXT = handleCard.CONTEXT;
	final This TOP = this;
	This tm = handleCard.tm;
	This every = handleCard.every;
	This config = handleCard.config;
	Drawable snapDrawable;
	LinearLayout gestureCard;
	LinearLayout templateDetails;
	LinearLayout details;
	LinearLayout actionContainer;
	ImageView snapshotView;
	TextView gestureNameTV;
	MaterialToolbar templateActions;
	ListView actionListView;
	PopupMenu options;
	GradientDrawable gestureBackground;
	GradientDrawable snapshotBackground;
	This helper;
	List actionList = config.getActionList(gestureName);
	List rowViews = new ArrayList();

	final int TEMPLATE_DETAILS = 100;
	final int SNAPSHOT = 101;
	final int DETAILS = 102;
	final int GESTURE_NAME = 103;
	final int ACTIONS_CONTAINER = 104;
	final int TEMPLATE_ACTIONS = 105;
	final int ACTION_LIST = 106;

	int DELETE = 1;
	int ADD = 2;
	int OPTIONS = 3;

	Object[][] menuItems = {
		{
			DELETE,
			"Delete",
			"delete.svg",
			new Runnable() { run() { TOP.deleteAction(); } }
		},
		{
			ADD,
			"Add",
			"add.svg",
			new Runnable() { run() { TOP.addAction(); } }
		},
		{
			OPTIONS,
			"Options",
			"dots-vertical.svg",
			new Runnable() { run() { TOP.showOptionBar(); } }
		}
	};

		
	build() {
		if (gestureCard != null) {
			return gestureCard;
		}

		gestureCard = new LinearLayout(CONTEXT);
		gestureCard.setOrientation(1);
		gestureBackground = new GradientDrawable();
		gestureBackground.setColor(handleCard.Res.Card.Template.BACKGROUND_COLOR);
		gestureBackground.setCornerRadius(handleCard.Res.Card.Template.BACKGROUND_RADIUS);
		gestureCard.setBackground(gestureBackground);
		gestureCard.setPadding(handleCard.Res.Card.Template.PADDING, handleCard.Res.Card.Template.PADDING, handleCard.Res.Card.Template.PADDING, handleCard.Res.Card.Template.PADDING);
		gestureCard.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
		gestureCard.setTag(TOP);

		templateDetails = new LinearLayout(CONTEXT);
		templateDetails.setId(TEMPLATE_DETAILS);
		templateDetails.setOrientation(0);
		templateDetails.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

		snapshotView = new ImageView(CONTEXT);
		snapshotView.setId(SNAPSHOT);
		snapshotBackground = new GradientDrawable();
		snapshotBackground.setColor(handleCard.Res.Card.Snapshot.BACKGROUND_COLOR);
		snapshotBackground.setCornerRadius(handleCard.Res.Card.Snapshot.BACKGROUND_RADIUS);
		LinearLayout.LayoutParams snapLp = new LinearLayout.LayoutParams(handleCard.Res.Card.Snapshot.CONTAINER_WIDTH, handleCard.Res.Card.Snapshot.CONTAINER_WIDTH);
		snapLp.rightMargin = handleCard.Res.Card.Snapshot.RIGHT_MARGIN;
		snapshotView.setLayoutParams(snapLp);
		snapshotView.setBackground(snapshotBackground);
		snapshotView.setClipToOutline(true);

		details = new LinearLayout(CONTEXT);
		details.setId(DETAILS);
		details.setOrientation(1);
		details.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

		gestureNameTV = new TextView(CONTEXT);
		gestureNameTV.setId(GESTURE_NAME);
		gestureNameTV.setText(gestureName);
		gestureNameTV.setTextSize(18);
		gestureNameTV.setTypeface(null, Typeface.BOLD);
		gestureNameTV.setTextColor(handleCard.Res.Card.Template.TITLE_COLOR);

		actionContainer = new LinearLayout(CONTEXT);
		actionContainer.setId(ACTIONS_CONTAINER);
		actionContainer.setOrientation(1);
		actionContainer.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
		
		details.addView(gestureNameTV);
		details.addView(actionContainer);
		templateDetails.addView(snapshotView);
		templateDetails.addView(details);
		gestureCard.addView(templateDetails);

		templateActions = new MaterialToolbar(CONTEXT);
		templateActions.setId(TEMPLATE_ACTIONS);
		templateActions.setContentInsetsAbsolute(0, 0);
		templateActions.setContentInsetsRelative(0, 0);
		templateActions.setPadding(0, 0, 0, 0);
		LinearLayout.LayoutParams templateActionsParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
		templateActions.setLayoutParams(templateActionsParams);
		templateActions.setVisibility(View.GONE);

		for (int i = 0; i < menuItems.length; i++) {
			Object[] menuItem = menuItems[i];
			MenuItem item = templateActions.getMenu().add(0, ((Integer) menuItem[0]).intValue(), 0, (String) menuItem[1]);
			item.setShowAsAction(2);
			final Runnable action = (Runnable) menuItem[3];
			item.setOnMenuItemClickListener(new MenuItem.OnMenuItemClickListener() {
				onMenuItemClick(MenuItem clickedItem) {
					if (action != null) action.run();
					return true;
				}
			});
			String iconPath = (String) menuItem[2];
			iconSet() {
				onSuccess(Drawable drawable) {
					Drawable mutDrawable = drawable.mutate();
					mutDrawable.setTint(handleCard.Res.Card.Template.TITLE_COLOR);
					item.setIcon(mutDrawable);
				}
				return this;
			}
			loadSvgIcon(CONTEXT, every.MAIN_DIRECTORY + "/res/main/" + iconPath, iconSet());
		}


		gestureCard.addView(templateActions);

		gestureCard.setOnClickListener(new View.OnClickListener() {
			onClick(View v) {
				TOP.toggleActions();
			}
		});

		refreshDetails();
		return gestureCard;
	}

	getView() {
		if (gestureCard == null) {
			build();
		}
		return gestureCard;
	}

	TemplateCardHelper(this);
	
	return this;
}