importCommands("lib.actions");
importCommands("lib.ui.misc");
importCommands("lib.ui.webview");

import android.app.Activity;
import android.view.Menu;
import android.view.MenuItem;
import android.view.View;
import android.view.Gravity;
import android.graphics.drawable.Drawable;
import android.content.res.ColorStateList;
import com.google.android.material.appbar.MaterialToolbar;
import bsh.This;
import android.widget.PopupMenu;

PopUpMenu(Activity activity, View anchorView) {
	PopupMenu popup = new PopupMenu(activity, anchorView, Gravity.END);
	Menu popupMenu = popup.getMenu();
    This every = tasker.getJavaVariable("everyGesture");
    String repo = every.updateManager.repo;
    String owner = every.updateManager.owner;
    final String REPO_URL = "https://github.com/" + owner + "/" + repo;
    
    Popup() {
        final int LEARN = (int) 201;
        final String LEARN_TEXT = "How to use";
        final String LEARN_URL = REPO_URL + "/blob/main/readme/Learn%20how%20to%20use%20this%20project.md#how-to-create-a-handle";

        final int REFRESH_LIST = (int) 202;
        final String REFRESH_LIST_TEXT = "Refresh Action List";

        final int REPORT_ISSUE = (int) 203;
        final String REPORT_ISSUE_TEXT = "Report Issue";
        final String ISSUE_URL = REPO_URL + "/issues/new?template=bug_report.md";

        final int TOGGLE_HELPER_MODE = (int) 204;
        final String TOGGLE_HELPER_MODE_TEXT = "Toggle Helper Mode";

        final int TOGGLE_DARK_THEME = (int) 205;
        final String TOGGLE_DARK_THEME_TEXT = "Toggle Dark Theme";

        final int FAQ_AND_DOCUMENTATION = (int) 206;
        final String FAQ_AND_DOCUMENTATION_TEXT = "FAQ and Documentation";
        final String FAQ_AND_DOCUMENTATION_URL = REPO_URL + "#faq--documentation";

        return this;
    }

    This Popup = Popup();

    // * Menu Items
    Object[][] menus = new Object[][] {
        {
            Popup.LEARN
            , Popup.LEARN_TEXT
            , new Runnable() {
                run() {
                    openWebView(Popup.LEARN_URL);
                }
            }
        },
        {
            Popup.FAQ_AND_DOCUMENTATION
            , Popup.FAQ_AND_DOCUMENTATION_TEXT
            , new Runnable() {
                run() {
                    openWebView(Popup.FAQ_AND_DOCUMENTATION_URL);
                }
            }
        },
        {
            Popup.REPORT_ISSUE
            , Popup.REPORT_ISSUE_TEXT
            , new Runnable() {
                run() {
                    browseUrl(Popup.ISSUE_URL);
                }
            }
        },
        {
            Popup.REFRESH_LIST
            , Popup.REFRESH_LIST_TEXT
            , new Runnable() {
                run() {
                    This every = tasker.getJavaVariable("everyGesture");
                    Runnable refresh = new Runnable() { 
                        run() {
                            every.Actions.refresh(true);
                        }
                    }; 
                    every.execute(refresh);
                }
            }
        },
        {
            Popup.TOGGLE_HELPER_MODE
            , Popup.TOGGLE_HELPER_MODE_TEXT
            , new Runnable() {
                run() {
                    everyAction(every.Actions.TOGGLE_HELPER_MODE);
                }
            }
        },
        {
            Popup.TOGGLE_DARK_THEME
            , Popup.TOGGLE_DARK_THEME_TEXT
            , new Runnable() {
                run() {
                    every.useDarkTheme = !every.useDarkTheme;
                    activity.finish();
                    everyAction(every.Actions.OPEN_MAIN_ACTIVITY);
                }
            }
        }
    };

    item(Object[] menuFormat) {
        int id = menuFormat[0];
        String title = menuFormat[1];
        Runnable onClick = menuFormat[2];
        return this;
    }

	for (int i = 0; i < menus.length; i++) {
        This menu = item(menus[i]);
        MenuItem menuItem = popupMenu.add(0, menu.id, i, menu.title);
        menuItem.setOnMenuItemClickListener(new MenuItem.OnMenuItemClickListener() {
            public boolean onMenuItemClick(MenuItem item) {
                menu.onClick.run();
                return true;
            }
        });
    }

	return popup;
}